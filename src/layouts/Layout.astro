---
import { ClientRouter } from "astro:transitions";
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
	title: string;
	lang: Lang;
	description?: string;
}

const { title, lang, description } = Astro.props;
const desc =
	description ??
	(lang === "de"
		? "Ausfall- & Verspätungstracker für den Frankfurter ÖPNV"
		: "Cancellation & delay tracker for Frankfurt public transport");
const canonicalUrl = new URL(
	Astro.url.pathname,
	Astro.site ?? "https://dummrum.jonas-strassel.de",
);
const otherLang = lang === "de" ? "en" : "de";
const otherPath = Astro.url.pathname.replace(`/${lang}`, `/${otherLang}`);
---

<!doctype html>
<html lang={lang} style="color-scheme: light dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={desc} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={desc} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={desc} />
		<link rel="canonical" href={canonicalUrl.href} />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#0f1117" />
		<ClientRouter />
		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚏</text></svg>"
		/>
	</head>
	<body class="bg-bg text-text min-h-screen font-sans">
		<div class="fixed top-3 right-3 z-50 flex items-center gap-3">
			<a
				href={otherPath}
				class="text-xs font-medium text-muted hover:text-emphasis transition-colors uppercase"
			>
				{otherLang}
			</a>
			<button
				id="share-btn"
				class="text-muted hover:text-emphasis transition-colors cursor-pointer"
				aria-label={t(lang, "share.button")}
				data-copied={t(lang, "share.copied")}
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" /><polyline points="16 6 12 2 8 6" /><line x1="12" y1="2" x2="12" y2="15" />
				</svg>
			</button>
			<a
				href="https://github.com/boredland/dumm-rum"
				class="text-muted hover:text-emphasis transition-colors"
				aria-label={t(lang, "nav.github")}
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 16 16"
					fill="currentColor"
				>
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
					/>
				</svg>
			</a>
		</div>
		<div class="max-w-[800px] mx-auto px-6 py-8 max-sm:px-4">
			<slot />
		</div>
		<button
			id="scroll-top"
			class="fixed bottom-4 right-4 z-50 hidden w-10 h-10 rounded-full bg-surface border border-border text-muted hover:text-emphasis transition-all cursor-pointer"
			aria-label="Scroll to top"
		>
			&uarr;
		</button>
		<script>
			function initShare() {
				const btn = document.getElementById("share-btn");
				if (!btn) return;
				btn.addEventListener("click", async () => {
					const url = window.location.href;
					const title = document.title;
					if (navigator.share) {
						navigator.share({ title, url }).catch(() => {});
					} else {
						await navigator.clipboard.writeText(url);
						const label = btn.dataset.copied!;
						const orig = btn.innerHTML;
						btn.textContent = label;
						setTimeout(() => { btn.innerHTML = orig; }, 1500);
					}
				});
			}
			document.addEventListener("astro:page-load", initShare);

			function initScrollTop() {
				const btn = document.getElementById("scroll-top");
				if (!btn) return;
				btn.addEventListener("click", () => {
					window.scrollTo({ top: 0, behavior: "smooth" });
				});
			}
			window.addEventListener("scroll", () => {
				document.getElementById("scroll-top")?.classList.toggle("hidden", window.scrollY < 400);
			}, { passive: true });
			document.addEventListener("astro:page-load", initScrollTop);

			function syncParams(updates: Record<string, string>) {
				const url = new URL(window.location.href);
				for (const [k, v] of Object.entries(updates)) {
					if (v) url.searchParams.set(k, v);
					else url.searchParams.delete(k);
				}
				history.replaceState(null, "", url);
			}

			function param(key: string): string {
				return new URL(window.location.href).searchParams.get(key) ?? "";
			}

			function stylePills(buttons: NodeListOf<HTMLButtonElement>, attr: string, active: string) {
				for (const b of buttons) {
					const match = (b.dataset as Record<string, string>)[attr] === active;
					b.classList.toggle("bg-surface-hover", match);
					b.classList.toggle("text-emphasis", match);
					b.classList.toggle("text-muted", !match);
				}
			}

			function isCoreHour(time: string): boolean {
				const h = parseInt(time.split(":")[0], 10);
				return (h >= 6 && h < 9) || (h >= 16 && h < 19);
			}

			function updateTelegramLink(direction: string, coreHours: boolean) {
				const link = document.getElementById("telegram-subscribe") as HTMLAnchorElement | null;
				if (!link) return;
				const line = link.dataset.line ?? "";
				const timeRanges = coreHours ? "06:00-09:00,16:00-19:00" : "";
				if (!direction && !timeRanges) {
					link.href = `https://t.me/rumsteh_bot?start=subscribe_${encodeURIComponent(line)}`;
					return;
				}
				const payload = [line, direction, timeRanges].join("|");
				const encoded = btoa(payload).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
				if (encoded.length <= 62) {
					link.href = `https://t.me/rumsteh_bot?start=s-${encoded}`;
				} else {
					link.href = `https://t.me/rumsteh_bot?start=subscribe_${encodeURIComponent(line)}`;
				}
			}

			function initDepartureFilters() {
				for (const wrapper of document.querySelectorAll("[data-departure-filter]")) {
					const el = wrapper as HTMLElement;
					if (el.dataset.initialized) continue;
					el.dataset.initialized = "1";
					const statusButtons = el.querySelectorAll<HTMLButtonElement>("[data-filter]");
					const hoursButtons = el.querySelectorAll<HTMLButtonElement>("[data-hours]");
					const dirButtons = el.querySelectorAll<HTMLButtonElement>("[data-dir]");
					const table = el.querySelector("tbody");
					if (!statusButtons.length || !table) continue;

					let activeStatus = param("status") || "issues";
					let activeHours = param("hours");
					let activeDir = param("dir");

					function applyAll() {
						for (const row of table!.querySelectorAll<HTMLElement>("tr[data-status]")) {
							const s = row.dataset.status;
							const statusMatch =
								activeStatus === "all" ||
								(activeStatus === "issues" && (s === "cancelled" || s === "delayed")) ||
								(activeStatus === "on_time" && s === "ok");
							const dirMatch = !activeDir || row.dataset.direction === activeDir;
							const hoursMatch = !activeHours || (row.dataset.time && isCoreHour(row.dataset.time));
							row.style.display = statusMatch && dirMatch && hoursMatch ? "" : "none";
						}
						syncParams({ status: activeStatus === "issues" ? "" : activeStatus, hours: activeHours, dir: activeDir });
						updateTelegramLink(activeDir, !!activeHours);
					}

					stylePills(statusButtons, "filter", activeStatus);
					for (const btn of statusButtons) {
						btn.addEventListener("click", () => {
							activeStatus = btn.dataset.filter!;
							stylePills(statusButtons, "filter", activeStatus);
							applyAll();
						});
					}

					stylePills(hoursButtons, "hours", activeHours);
					for (const btn of hoursButtons) {
						btn.addEventListener("click", () => {
							activeHours = btn.dataset.hours!;
							stylePills(hoursButtons, "hours", activeHours);
							applyAll();
						});
					}

					stylePills(dirButtons, "dir", activeDir);
					for (const btn of dirButtons) {
						btn.addEventListener("click", () => {
							activeDir = btn.dataset.dir!;
							stylePills(dirButtons, "dir", activeDir);
							applyAll();
						});
					}

					applyAll();
				}
			}
			document.addEventListener("astro:page-load", initDepartureFilters);

			function applyLandingFilters() {
				const input = document.getElementById("search") as HTMLInputElement | null;
				const q = input?.value.toLowerCase().trim() ?? "";
				const cat = activeCat;
				const cards = document.querySelectorAll<HTMLElement>("[data-search]");
				const sections = new Set<HTMLElement>();
				for (const card of cards) {
					const matchText = !q || card.dataset.search!.includes(q);
					let matchCat = !cat;
					if (cat && card.dataset.categories) {
						const cats = cat.split(",");
						matchCat = cats.some((c) => card.dataset.categories!.split(",").includes(c));
					}
					const show = matchText && matchCat;
					card.style.display = show ? "" : "none";
					const section = card.closest("details");
					if (section && show) sections.add(section as HTMLElement);
				}
				for (const details of document.querySelectorAll<HTMLDetailsElement>("details.group")) {
					if (q || cat) details.open = sections.has(details);
				}
				syncParams({ q: q, cat: cat });
			}

			let activeCat = "";

			function initSearch() {
				const input = document.getElementById("search") as HTMLInputElement | null;
				if (!input) return;
				const q = param("q");
				if (q) input.value = q;
				input.addEventListener("input", applyLandingFilters);
			}

			function initCategoryFilter() {
				const container = document.getElementById("category-filter");
				if (!container) return;
				activeCat = param("cat");
				const buttons = container.querySelectorAll<HTMLButtonElement>("[data-cat]");
				stylePills(buttons, "cat", activeCat);
				for (const btn of buttons) {
					btn.addEventListener("click", () => {
						activeCat = btn.dataset.cat!;
						stylePills(buttons, "cat", activeCat);
						applyLandingFilters();
					});
				}
			}

			document.addEventListener("keydown", (e) => {
				if ((e.ctrlKey || e.metaKey) && e.key === "k") {
					e.preventDefault();
					const input = document.getElementById("search") as HTMLInputElement | null;
					if (input) { input.focus(); input.select(); }
				}
			});
			document.addEventListener("astro:page-load", () => {
				initSearch();
				initCategoryFilter();
				if (param("q") || param("cat")) applyLandingFilters();
			});

			let refreshTimer: ReturnType<typeof setInterval>;
			document.addEventListener("astro:page-load", () => {
				clearInterval(refreshTimer);
				refreshTimer = setInterval(async () => {
					if (document.hidden) return;
					const search = document.getElementById("search") as HTMLInputElement | null;
					if (search && (search === document.activeElement || search.value)) return;
					const { navigate } = await import("astro:transitions/client");
					navigate(window.location.href, { history: "replace" });
				}, 180_000);
			});
		</script>
	</body>
</html>

<style>
	@import "../styles/app.css";
</style>
