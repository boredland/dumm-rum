---
import { ClientRouter } from "astro:transitions";
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
	title: string;
	lang: Lang;
	description?: string;
}

const { title, lang, description } = Astro.props;
const desc =
	description ??
	(lang === "de"
		? "Ausfall- & Verspätungstracker für den Frankfurter ÖPNV"
		: "Cancellation & delay tracker for Frankfurt public transport");
const canonicalUrl = new URL(
	Astro.url.pathname,
	Astro.site ?? "https://dummrum.jonas-strassel.de",
);
const otherLang = lang === "de" ? "en" : "de";
const otherPath = Astro.url.pathname.replace(`/${lang}`, `/${otherLang}`);
---

<!doctype html>
<html lang={lang} style="color-scheme: light dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="refresh" content="300" />
		<title>{title}</title>
		<meta name="description" content={desc} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={desc} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={desc} />
		<link rel="canonical" href={canonicalUrl.href} />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#0f1117" />
		<ClientRouter />
		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚌</text></svg>"
		/>
	</head>
	<body class="bg-bg text-text min-h-screen font-sans">
		<div class="fixed top-3 right-3 z-50 flex items-center gap-3">
			<a
				href={otherPath}
				class="text-xs font-medium text-muted hover:text-emphasis transition-colors uppercase"
			>
				{otherLang}
			</a>
			<a
				href="https://github.com/boredland/dumm-rum"
				class="text-muted hover:text-emphasis transition-colors"
				aria-label={t(lang, "nav.github")}
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 16 16"
					fill="currentColor"
				>
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
					/>
				</svg>
			</a>
		</div>
		<div class="max-w-[800px] mx-auto px-6 py-8 max-sm:px-4">
			<slot />
		</div>
	</body>
</html>

<style>
	@import "../styles/app.css";
</style>
