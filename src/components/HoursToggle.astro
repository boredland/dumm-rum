---
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
	basePath: string;
	coreOnly: boolean;
	daysFilter: string;
	category?: string;
	lang: Lang;
}

const { basePath, coreOnly, daysFilter, category, lang } = Astro.props;

function buildHref(params: {
	hours?: string;
	days?: string;
	cat?: string;
}): string {
	const search = new URLSearchParams();
	const hours = params.hours ?? (coreOnly ? "core" : "");
	const days = params.days ?? daysFilter;
	const cat = params.cat ?? category;
	if (hours) search.set("hours", hours);
	if (days) search.set("days", days);
	if (cat) search.set("cat", cat);
	const qs = search.toString();
	return qs ? `${basePath}?${qs}` : basePath;
}
const pill =
	"inline-block px-3 py-1 rounded-full text-xs font-semibold no-underline";

const categories = [
	{ value: "", label: t(lang, "filter.all"), icon: "" },
	{ value: "U-Bahn", label: "U-Bahn", icon: "🚇" },
	{ value: "S", label: "S-Bahn", icon: "🚈" },
	{ value: "Tram", label: "Tram", icon: "🚋" },
	{ value: "Bus", label: "Bus", icon: "🚌" },
	{ value: "RE,RB", label: "RE/RB", icon: "🚆" },
];
---

<div class="flex flex-wrap gap-x-4 gap-y-2 mb-6 items-center">
	<div class="flex gap-2 items-center">
		<a
			href={buildHref({ hours: "" })}
			class:list={[
				pill,
				!coreOnly
					? "bg-success/10 text-success"
					: "bg-success/10 text-success opacity-50",
			]}
		>
			{t(lang, "hours.all")}
		</a>
		<a
			href={buildHref({ hours: "core" })}
			class:list={[
				pill,
				coreOnly
					? "bg-success/10 text-success"
					: "bg-success/10 text-success opacity-50",
			]}
		>
			{t(lang, "hours.core")}
		</a>
		{coreOnly && <span class="text-muted text-sm">{t(lang, "hours.core_range")}</span>}
	</div>

	<div class="flex gap-2 items-center">
		<a
			href={buildHref({ days: "all" })}
			class:list={[
				pill,
				daysFilter === "all" || daysFilter === ""
					? "bg-link/10 text-link"
					: "bg-link/10 text-link opacity-50",
			]}
		>
			{t(lang, "days.all")}
		</a>
		<a
			href={buildHref({ days: "today" })}
			class:list={[
				pill,
				daysFilter === "today"
					? "bg-link/10 text-link"
					: "bg-link/10 text-link opacity-50",
			]}
		>
			{t(lang, "days.today")}
		</a>
		<a
			href={buildHref({ days: "weekdays" })}
			class:list={[
				pill,
				daysFilter === "weekdays"
					? "bg-link/10 text-link"
					: "bg-link/10 text-link opacity-50",
			]}
		>
			{t(lang, "days.weekdays")}
		</a>
		<a
			href={buildHref({ days: "weekends" })}
			class:list={[
				pill,
				daysFilter === "weekends"
					? "bg-link/10 text-link"
					: "bg-link/10 text-link opacity-50",
			]}
		>
			{t(lang, "days.weekends")}
		</a>
	</div>

	{category !== undefined && (
		<div class="flex gap-2 items-center flex-wrap">
			{categories.map((cat) => (
				<a
					href={buildHref({ cat: cat.value })}
					class:list={[
						pill,
						category === cat.value
							? "bg-warning/10 text-warning"
							: "bg-warning/10 text-warning opacity-50",
					]}
				>
					{cat.icon}{cat.icon ? " " : ""}{cat.label}
				</a>
			))}
		</div>
	)}
</div>
