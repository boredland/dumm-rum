---
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
	basePath: string;
	coreOnly: boolean;
	lang: Lang;
}

const { basePath, coreOnly, lang } = Astro.props;
---

<div class="flex gap-2 mb-6 items-center">
	<a
		href={basePath}
		class:list={[
			"inline-block px-3 py-1 rounded-full text-xs font-semibold no-underline",
			!coreOnly
				? "bg-success/10 text-success"
				: "bg-success/10 text-success opacity-50",
		]}
	>
		{t(lang, "hours.all")}
	</a>
	<a
		href={`${basePath}?hours=core`}
		class:list={[
			"inline-block px-3 py-1 rounded-full text-xs font-semibold no-underline",
			coreOnly
				? "bg-success/10 text-success"
				: "bg-success/10 text-success opacity-50",
		]}
	>
		{t(lang, "hours.core")}
	</a>
	{coreOnly && <span class="text-muted text-sm">{t(lang, "hours.core_range")}</span>}
</div>
