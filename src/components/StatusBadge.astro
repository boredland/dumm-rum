---
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
	lang: Lang;
	status: "cancelled" | "ghost" | "delayed" | "ok";
	delayMin?: number | null;
}

const { lang, status, delayMin } = Astro.props;

const badge = {
	cancelled: {
		bg: "bg-danger/15 text-danger",
		key: "status.cancelled" as const,
	},
	ghost: {
		bg: "bg-purple-500/15 text-purple-400",
		key: "status.ghost" as const,
	},
	delayed: { bg: "bg-warning/15 text-warning", key: "status.delayed" as const },
	ok: { bg: "bg-success/10 text-success", key: "status.ok" as const },
}[status];
---

<span class:list={["inline-block px-2 py-0.5 rounded-full text-xs font-semibold", badge.bg]}>{t(lang, badge.key)}</span>
{delayMin != null && delayMin !== 0 && (
	<span class:list={["text-xs ml-1", delayMin > 0 ? "text-warning" : "text-success"]}>
		{delayMin > 0 ? "+" : ""}{delayMin}m
	</span>
)}
