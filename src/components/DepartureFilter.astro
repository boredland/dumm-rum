---
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const pill =
	"px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-colors select-none";
---

<div class="flex flex-wrap gap-x-4 gap-y-2 mb-3">
	<div class="flex gap-2">
		<button class:list={[pill, "bg-surface-hover text-emphasis"]} data-filter="issues">{t(lang, "filter.issues")}</button>
		<button class:list={[pill, "text-muted"]} data-filter="all">{t(lang, "filter.all")}</button>
		<button class:list={[pill, "text-muted"]} data-filter="on_time">{t(lang, "filter.on_time")}</button>
	</div>
	<div class="flex gap-2">
		<button class:list={[pill, "bg-surface-hover text-emphasis"]} data-hours="">{t(lang, "hours.all")}</button>
		<button class:list={[pill, "text-muted"]} data-hours="core">{t(lang, "hours.core")}</button>
	</div>
</div>
