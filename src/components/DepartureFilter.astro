---
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const pill =
	"px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-colors select-none";
---

<div data-filter-buttons class="flex gap-2 mb-3">
	<button class:list={[pill, "bg-surface-hover text-emphasis"]} data-filter="issues">{t(lang, "filter.issues")}</button>
	<button class:list={[pill, "text-muted"]} data-filter="all">{t(lang, "filter.all")}</button>
	<button class:list={[pill, "text-muted"]} data-filter="on_time">{t(lang, "filter.on_time")}</button>
</div>
