---
import type { DayStats } from "../lib/queries";

interface Props {
	days: DayStats[];
}

const { days } = Astro.props;
const sorted = [...days].reverse();

const W = 760;
const L = 36;
const H = 120;
const labelH = 40;
const top = 16;
const usable = W - L;
const gap = Math.max(1, Math.floor((usable / sorted.length) * 0.15));
const bw = Math.max(
	2,
	Math.floor((usable - gap * sorted.length) / sorted.length),
);
const svgH = H + labelH + top;
const maxRate = Math.max(
	10,
	...sorted.map((d) => (d.total > 0 ? (d.cancelled / d.total) * 100 : 0)),
);
const maxLabels = Math.floor(usable / 40);

const gridLines = [0, 25, 50, 75, 100].filter((v) => v <= maxRate * 1.1);

const gridData = gridLines.map((v) => ({
	v,
	y: top + H - (v / maxRate) * H,
}));

const barData = sorted.map((d, i) => {
	const rate = d.total > 0 ? (d.cancelled / d.total) * 100 : 0;
	const barH = (rate / maxRate) * H;
	const x = L + i * (bw + gap) + gap;
	const y = top + H - barH;
	const showLabel =
		sorted.length <= maxLabels ||
		i % Math.ceil(sorted.length / maxLabels) === 0;
	return {
		date: d.date,
		cancelled: d.cancelled,
		total: d.total,
		rate,
		barH: Math.max(barH, 1),
		x,
		y,
		showLabel,
		showPct: rate > 0 && bw >= 14,
		labelSlice: d.date.slice(5),
	};
});
---

{
	sorted.length > 0 && (
		<div class="bg-surface border border-border rounded-xl p-5 pb-3 mb-8 overflow-x-auto">
			<svg
				viewBox={`0 0 ${W} ${svgH}`}
				preserveAspectRatio="xMinYMid meet"
				class="block w-full h-auto"
			>
				{gridData.map((g) => (
					<Fragment>
						<line
							x1={L - 2}
							x2={W}
							y1={g.y}
							y2={g.y}
							stroke="var(--color-border-dim)"
						/>
						<text
							x={L - 4}
							y={g.y + 3}
							text-anchor="end"
							font-size="8"
							fill="var(--color-dimmed)"
							font-family="-apple-system, system-ui, sans-serif"
						>
							{g.v}%
						</text>
					</Fragment>
				))}
				{barData.map((b) => (
					<Fragment>
						<rect
							x={b.x}
							y={b.y}
							width={bw}
							height={b.barH}
							rx="3"
							fill={b.rate > 0 ? "var(--color-danger)" : "var(--color-border-dim)"}
							opacity={b.rate > 0 ? 0.85 : 0.4}
						>
							<title>
								{b.date}: {b.rate.toFixed(1)}% ({b.cancelled}/{b.total})
							</title>
						</rect>
						{b.showPct && (
							<text
								x={b.x + bw / 2}
								y={b.y - 3}
								text-anchor="middle"
								font-size="8"
								fill="var(--color-muted)"
								font-family="-apple-system, system-ui, sans-serif"
							>
								{b.rate.toFixed(0)}%
							</text>
						)}
						{b.showLabel && (
							<text
								x={b.x + bw / 2}
								y={top + H + 12}
								text-anchor="middle"
								font-size="8"
								fill="var(--color-dimmed)"
								font-family="-apple-system, system-ui, sans-serif"
								transform={`rotate(45 ${b.x + bw / 2} ${top + H + 12})`}
							>
								{b.labelSlice}
							</text>
						)}
					</Fragment>
				))}
			</svg>
		</div>
	)
}
