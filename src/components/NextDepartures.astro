---
import { env } from "cloudflare:workers";
import { createDb } from "../db/client";
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";
import { getNextDepartures } from "../lib/queries";
import { findStation } from "../lib/stations";
import { shortStationName } from "../lib/utils";

interface Props {
	stationSlug: string;
	lang: Lang;
}

const db = createDb(env.DB);
const { stationSlug, lang } = Astro.props;
const station = findStation(stationSlug);
if (!station) return;

const nextDeps = await getNextDepartures(db, station);
---

{
	nextDeps.length > 0 && (
		<details class="mb-8">
			<summary class="text-xs uppercase tracking-wide text-muted font-semibold mb-3 cursor-pointer select-none">
				{t(lang, "section.next_departures")}
			</summary>
			<div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 max-sm:grid-cols-1 mt-3">
				{nextDeps.map((d) => {
					const time = d.time.slice(0, 5);
					const rt = d.rtTime?.slice(0, 5);
					return (
						<div class="bg-surface border border-border rounded-xl p-5">
							<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
								{shortStationName(d.direction)}
							</div>
							<div class="text-2xl font-bold tabular-nums">
								{time}
								{rt && rt !== time && (
									<span class="text-warning">
										{" "}&rarr; {rt}
									</span>
								)}
							</div>
							<div class="text-sm text-muted">{d.line}</div>
						</div>
					);
				})}
			</div>
		</details>
	)
}
