---
import type { Lang } from "../lib/i18n";
import { reliabilityScore, scoreBorderColor } from "../lib/utils";

interface Props {
	days: { date: string; cancelled: number; delayed: number; total: number }[];
	lang: Lang;
}

const { days, lang } = Astro.props;

const weekdayNames =
	lang === "de"
		? ["So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"]
		: ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

const buckets = Array.from({ length: 7 }, () => ({
	cancelled: 0,
	delayed: 0,
	total: 0,
}));
for (const d of days) {
	const dow = new Date(`${d.date}T00:00:00`).getDay();
	buckets[dow].cancelled += d.cancelled;
	buckets[dow].delayed += d.delayed;
	buckets[dow].total += d.total;
}

const ordered = [1, 2, 3, 4, 5, 6, 0];
---

<div class="flex items-end gap-2 h-24 mb-8">
	{ordered.map((dow) => {
		const b = buckets[dow];
		const score = reliabilityScore(b.cancelled, b.delayed, b.total);
		const height = b.total > 0 ? Math.max(score, 2) : 2;
		const color = scoreBorderColor(score).replace("border-", "bg-");
		return (
			<div class="flex-1 flex flex-col items-center gap-1">
				<div class="text-[0.6rem] text-muted tabular-nums">{b.total > 0 ? score : "\u2014"}</div>
				<div class="w-full flex items-end" style="height:72px">
					<div
						class:list={["w-full rounded-t", color]}
						style={`height:${height}%`}
					/>
				</div>
				<div class="text-[0.65rem] text-muted font-medium">{weekdayNames[dow]}</div>
			</div>
		);
	})}
</div>
