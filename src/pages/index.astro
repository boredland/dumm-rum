---
import { env } from "cloudflare:workers";
import HoursToggle from "../components/HoursToggle.astro";
import Layout from "../layouts/Layout.astro";
import { getStationSummaries } from "../lib/queries";
import { STATIONS, stationIcon } from "../lib/stations";
import { pct, shortDir } from "../lib/utils";

const coreOnly = Astro.url.searchParams.get("hours") === "core";
const hoursParam = coreOnly ? "?hours=core" : "";
const stationStats = await getStationSummaries(env.DB, STATIONS, coreOnly);
---

<Layout title="DummRum">
	<header class="mb-8">
		<h1 class="text-2xl font-bold text-white flex items-center gap-2">
			🚌🚋🚇 DummRum
		</h1>
		<p class="text-muted text-sm mt-1">
			Wissen, warum man dumm rumsteht
		</p>
	</header>

	<HoursToggle basePath="/" coreOnly={coreOnly} />

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">
		Stations
	</p>

	<div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 mb-8 max-sm:grid-cols-1">
		{
			STATIONS.map((s) => {
				const st = stationStats.get(s.id);
				const rate =
					st && st.total > 0
						? (st.cancelled / st.total) * 100
						: 0;
				const borderColor =
					rate >= 5
						? "border-danger"
						: rate >= 1
							? "border-warning"
							: "border-success";
				return (
					<a
						href={`/${s.slug}${hoursParam}`}
						class:list={[
							"bg-surface border rounded-xl p-5 no-underline hover:bg-surface-hover transition-colors",
							borderColor,
						]}
					>
						<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
							{stationIcon(s.type)} {s.type}
						</div>
						<div class="text-lg font-bold text-white">
							{shortDir(s.name)}
						</div>
						{st && (
							<div class="text-sm text-muted mt-1">
								{pct(st.cancelled, st.total)}% cancelled
							</div>
						)}
					</a>
				);
			})
		}
	</div>
</Layout>
