---
import { env } from "cloudflare:workers";
import { all } from "better-all";
import HoursToggle from "../../../../components/HoursToggle.astro";
import { createDb } from "../../../../db/client";
import Layout from "../../../../layouts/Layout.astro";
import { langFromParams, t } from "../../../../lib/i18n";
import {
	getLineStats,
	getOldestDate,
	parseFilter,
} from "../../../../lib/queries";
import { categoryIcons } from "../../../../lib/stations";
import { fmtDate, fmtDelay, onTimeRate, pct } from "../../../../lib/utils";

const db = createDb(env.DB);
const lang = langFromParams(Astro.params);
const line = decodeURIComponent(Astro.params.line!);
const filter = parseFilter(Astro.url);
const coreOnly = Astro.url.searchParams.get("hours") === "core";
const daysFilter = filter.days ?? "today";

const { lineStats, oldestDate } = await all({
	lineStats: () => getLineStats(db, line, filter),
	oldestDate: () => getOldestDate(db, { line }),
});
const { days, operators, categories } = lineStats;

const totalDepartures = days.reduce((s, d) => s + d.total, 0);
const totalCancelled = days.reduce((s, d) => s + d.cancelled, 0);
const totalGhost = days.reduce((s, d) => s + d.ghost, 0);
const totalDelayed = days.reduce((s, d) => s + d.delayed, 0);
const score = onTimeRate(totalCancelled, totalDelayed, totalDepartures);
const scoreWithGhosts = onTimeRate(
	totalCancelled + totalGhost,
	totalDelayed,
	totalDepartures,
);
---

<Layout title={`${t(lang, "table.line")} ${line}`} lang={lang}>
	<a
		href={`/${lang}`}
		class="inline-flex items-center gap-1 text-muted text-sm mb-6 hover:text-link no-underline"
	>
		&larr; {t(lang, "nav.all_stations")}
	</a>

	<header class="mb-6">
		<h1 class="text-2xl font-bold text-emphasis">{categoryIcons(categories)} {line}</h1>
		<p class="text-muted text-sm mt-1">
			{operators.join(", ")}
			{oldestDate && (
				<>
					{` \u2014 ${t(lang, "stat.since")} `}<time datetime={oldestDate}>{fmtDate(oldestDate, lang)}</time>
				</>
			)}
		</p>
		<a
			id="telegram-subscribe"
			href={(() => {
				if (!coreOnly) return `https://t.me/rumsteh_bot?start=subscribe_${encodeURIComponent(line)}`;
				const encoded = btoa(`${line}||06:00-09:00,16:00-19:00`).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
				return encoded.length <= 62
					? `https://t.me/rumsteh_bot?start=s-${encoded}`
					: `https://t.me/rumsteh_bot?start=subscribe_${encodeURIComponent(line)}`;
			})()}
			data-line={line}
			class="inline-flex items-center gap-1 text-xs text-link no-underline hover:underline mt-2"
			target="_blank"
			rel="noopener"
		>
			📢 {t(lang, "telegram.subscribe")}
		</a>
	</header>

	<HoursToggle
		basePath={`/${lang}/line/${encodeURIComponent(line)}`}
		coreOnly={coreOnly}
		daysFilter={daysFilter}
		lang={lang}
	/>

	<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.departures")}</div>
			<div class="text-4xl font-bold tabular-nums">{totalDepartures.toLocaleString(lang)}</div>
			<div class="text-sm text-muted mt-1">{t(lang, "stat.reliability")}: {score}%{totalGhost > 0 && <span class="text-purple-400"> (👻 {scoreWithGhosts}%)</span>}</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.cancelled")}</div>
			<div class:list={["text-4xl font-bold tabular-nums", totalCancelled > 0 ? "text-danger" : "text-success"]}>
				{totalCancelled}
			</div>
			<div class="text-sm text-muted mt-1">{pct(totalCancelled, totalDepartures)}% {t(lang, "stat.rate")}</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">👻 {t(lang, "stat.ghost")}</div>
			<div class:list={["text-4xl font-bold tabular-nums", totalGhost > 0 ? "text-purple-400" : "text-success"]}>
				{totalGhost}
			</div>
			<div class="text-sm text-muted mt-1">{pct(totalGhost, totalDepartures)}% {t(lang, "stat.rate")}</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "table.delayed")}</div>
			<div class:list={["text-4xl font-bold tabular-nums", totalDelayed > 0 ? "text-warning" : "text-success"]}>
				{totalDelayed}
			</div>
			<div class="text-sm text-muted mt-1">{pct(totalDelayed, totalDepartures)}% {t(lang, "stat.rate")}</div>
		</div>
	</div>

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">{t(lang, "section.daily_breakdown")}</p>
	<div class="bg-surface border border-border rounded-xl overflow-hidden">
		<table class="w-full border-collapse">
			<thead>
				<tr class="bg-surface-hover border-b border-border">
					{[t(lang, "table.date"), t(lang, "table.th.total"), t(lang, "table.th.cancelled"), t(lang, "table.th.ghost"), t(lang, "table.th.delayed"), t(lang, "table.otp")].map((h) => (
						<th class="text-left px-2 sm:px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{h}</th>
					))}
				</tr>
			</thead>
			<tbody>
				{
					days.length > 0 ? (
						days.map((d) => {
							const issues = d.cancelled + d.delayed;
							return (
								<tr class="border-b border-border-dim last:border-b-0 hover:bg-surface-hover">
									<td class="px-2 sm:px-4 py-2.5 text-sm tabular-nums">
										<a href={`/${lang}/line/${encodeURIComponent(line)}/day/${d.date}${Astro.url.search}`} class="text-link no-underline hover:underline">
											<time datetime={d.date}>{fmtDate(d.date, lang)}</time>
										</a>
									</td>
									<td class="px-2 sm:px-4 py-2.5 text-sm tabular-nums">{d.total}</td>
									<td class="px-2 sm:px-4 py-2.5 text-sm">
										{d.cancelled > 0 ? (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-danger/15 text-danger">{d.cancelled}</span>
										) : (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-success/10 text-success">0</span>
										)}
									</td>
									<td class="px-2 sm:px-4 py-2.5 text-sm">
										{d.ghost > 0 ? (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-500/15 text-purple-400">{d.ghost}</span>
										) : (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-success/10 text-success">0</span>
										)}
									</td>
									<td class="px-2 sm:px-4 py-2.5 text-sm">
										{d.delayed > 0 ? (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-warning/15 text-warning">{d.delayed}</span>
										) : (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-success/10 text-success">0</span>
										)}
										{d.avgDelay !== null && d.avgDelay > 0 && <span class="text-xs text-muted ml-1">{fmtDelay(d.avgDelay)}</span>}
									</td>
									<td class="px-2 sm:px-4 py-2.5 text-sm tabular-nums">{pct(d.total - issues, d.total)}%{d.ghost > 0 && <span class="text-purple-400"> ({pct(d.total - issues - d.ghost, d.total)}%)</span>}</td>
								</tr>
							);
						})
					) : (
						<tr><td colspan="6" class="text-center text-dimmed py-8">{t(lang, "table.no_data")}</td></tr>
					)
				}
			</tbody>
		</table>
	</div>
</Layout>
