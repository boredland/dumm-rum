---
import { env } from "cloudflare:workers";
import { all } from "better-all";
import DepartureFilter from "../../../../../components/DepartureFilter.astro";
import StatusBadge from "../../../../../components/StatusBadge.astro";
import { createDb } from "../../../../../db/client";
import Layout from "../../../../../layouts/Layout.astro";
import { langFromParams, t } from "../../../../../lib/i18n";
import { getHaiku, getLineDayJourneys } from "../../../../../lib/queries";
import { categoryIcons } from "../../../../../lib/stations";
import {
	DELAY_THRESHOLD_MIN,
	delayMinutes,
	fmtDate,
	pct,
	shortStationName,
} from "../../../../../lib/utils";

const lang = langFromParams(Astro.params);
const line = decodeURIComponent(Astro.params.line!);
const date = Astro.params.date!;

const db = createDb(env.DB);
const { departures, haiku } = await all({
	departures: () => getLineDayJourneys(db, line, date),
	haiku: () => getHaiku(db, date, lang),
});

const cancelledCount = departures.filter((d) => d.cancelled).length;
const ghostCount = departures.filter((d) => d.ghost && !d.cancelled).length;
const categories = [
	...new Set(departures.map((d) => d.category).filter(Boolean)),
];
const destinations = [...new Set(departures.map((d) => d.direction))];
const delayedCount = departures.filter(
	(d) =>
		!d.cancelled &&
		d.rtTime &&
		d.rtDate &&
		delayMinutes(d.date, d.time, d.rtDate, d.rtTime) >= DELAY_THRESHOLD_MIN,
).length;
---

<Layout title={`${line} — ${fmtDate(date, lang)}`} lang={lang}>
	<a
		href={`/${lang}/line/${encodeURIComponent(line)}`}
		class="inline-flex items-center gap-1 text-muted text-sm mb-6 hover:text-link no-underline"
	>
		&larr; {t(lang, "nav.back_to_line")}
	</a>

	<header class="mb-6">
		<h1 class="text-2xl font-bold text-emphasis">{categoryIcons(categories)} {line} &mdash; <time datetime={date}>{fmtDate(date, lang)}</time></h1>
		{haiku && (
			<div class="mt-3">
				<h2 class="text-xs font-medium text-muted uppercase tracking-wide mb-1">{t(lang, "haiku.heading")}</h2>
				<blockquote class="pl-4 border-l-[3px] border-border italic text-haiku whitespace-pre-line">
					{haiku}
				</blockquote>
			</div>
		)}
		<a
			id="telegram-subscribe"
			href={`https://t.me/rumsteh_bot?start=subscribe_${encodeURIComponent(line)}`}
			data-line={line}
			class="inline-flex items-center gap-1 text-xs text-link no-underline hover:underline mt-2"
			target="_blank"
			rel="noopener"
		>
			📢 {t(lang, "telegram.subscribe")}
		</a>
	</header>

	<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.departures")}</div>
			<div class="text-4xl font-bold tabular-nums">{departures.length}</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "table.cancelled")}</div>
			<div class:list={["text-4xl font-bold tabular-nums", cancelledCount > 0 ? "text-danger" : "text-success"]}>
				{cancelledCount}
			</div>
			<div class="text-sm text-muted mt-1">{pct(cancelledCount, departures.length)}%</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">👻 {t(lang, "stat.ghost")}</div>
			<div class:list={["text-4xl font-bold tabular-nums", ghostCount > 0 ? "text-purple-400" : "text-success"]}>
				{ghostCount}
			</div>
			<div class="text-sm text-muted mt-1">{pct(ghostCount, departures.length)}%</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "table.delayed")}</div>
			<div class:list={["text-4xl font-bold tabular-nums", delayedCount > 0 ? "text-warning" : "text-success"]}>
				{delayedCount}
			</div>
			<div class="text-sm text-muted mt-1">{pct(delayedCount, departures.length)}%</div>
		</div>
	</div>

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">{t(lang, "section.all_departures")}</p>
	<div data-departure-filter>
	<DepartureFilter lang={lang} />
	{destinations.length > 1 && (
		<div data-direction-filter class="flex flex-wrap gap-2 mb-3">
			<button data-dir="" class="px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-colors select-none bg-surface-hover text-emphasis">{t(lang, "filter.all_directions")}</button>
			{destinations.map((dir) => (
				<button data-dir={dir} class="px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-colors select-none text-muted">{shortStationName(dir)}</button>
			))}
		</div>
	)}
	<div class="bg-surface border border-border rounded-xl overflow-hidden">
		<table class="w-full border-collapse">
			<thead>
				<tr class="bg-surface-hover border-b border-border">
					{[t(lang, "table.time"), t(lang, "table.station"), t(lang, "table.direction"), t(lang, "table.status")].map((h) => (
						<th class="text-left px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{h}</th>
					))}
				</tr>
			</thead>
			<tbody>
				{
					departures.length > 0 ? (
						departures.map((d) => {
							const time = d.time.slice(0, 5);
							const rawDelay = d.rtTime && d.rtDate
								? delayMinutes(d.date, d.time, d.rtDate, d.rtTime)
								: null;
							const delayMin = rawDelay !== null ? Math.round(rawDelay) : null;
const status = d.cancelled ? "cancelled" : d.ghost ? "ghost" : (rawDelay !== null && rawDelay >= DELAY_THRESHOLD_MIN) ? "delayed" : "ok";
							return (
								<tr data-status={status} data-direction={d.direction} data-time={time} class="border-b border-border-dim last:border-b-0 hover:bg-surface-hover">
									<td class="px-4 py-2.5 text-sm tabular-nums">
										{time}
									</td>
									<td class="px-4 py-2.5 text-sm truncate max-w-[100px]" title={d.stop ?? ""}>{shortStationName(d.stop ?? "")}</td>
									<td class="px-4 py-2.5 text-sm truncate max-w-[100px]" title={d.direction}>{shortStationName(d.direction)}</td>
									<td class="px-4 py-2.5 text-sm">
										<StatusBadge lang={lang} status={status} delayMin={delayMin} />
									</td>
								</tr>
							);
						})
					) : (
						<tr><td colspan="4" class="text-center text-dimmed py-8">{t(lang, "table.no_departures")}</td></tr>
					)
				}
			</tbody>
		</table>
	</div>
	</div>
</Layout>
