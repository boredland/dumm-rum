---
import { env } from "cloudflare:workers";
import CancellationChart from "../../../components/CancellationChart.astro";
import HoursToggle from "../../../components/HoursToggle.astro";
import { createDb } from "../../../db/client";
import Layout from "../../../layouts/Layout.astro";
import { langFromParams, t } from "../../../lib/i18n";
import { getOperatorStats } from "../../../lib/queries";
import { pct } from "../../../lib/utils";

const db = createDb(env.DB);
const lang = langFromParams(Astro.params);
const operator = decodeURIComponent(Astro.params.operator!);
const coreOnly = Astro.url.searchParams.get("hours") === "core";

const { days, lines } = await getOperatorStats(db, operator, coreOnly);

const totalDepartures = days.reduce((s, d) => s + d.total, 0);
const totalCancelled = days.reduce((s, d) => s + d.cancelled, 0);
const chartDays = days.map((d) => ({
	...d,
	avgDelay: null,
	plannedFreq: null,
	actualFreq: null,
}));
---

<Layout title={operator} lang={lang}>
	<a
		href={`/${lang}`}
		class="inline-flex items-center gap-1 text-muted text-sm mb-6 hover:text-link no-underline"
	>
		&larr; {t(lang, "nav.all_stations")}
	</a>

	<header class="mb-6">
		<h1 class="text-2xl font-bold text-emphasis">{operator}</h1>
		<p class="text-muted text-sm mt-1">
			{t(lang, "operator.lines")}: {lines.join(", ")}
		</p>
	</header>

	<HoursToggle
		basePath={`/${lang}/operator/${encodeURIComponent(operator)}`}
		coreOnly={coreOnly}
		lang={lang}
	/>

	<div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 mb-8 max-sm:grid-cols-1">
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
				{t(lang, "stat.departures")}
			</div>
			<div class="text-4xl font-bold tabular-nums">{totalDepartures}</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
				{t(lang, "table.cancelled")}
			</div>
			<div
				class:list={[
					"text-4xl font-bold tabular-nums",
					totalCancelled > 0 ? "text-danger" : "text-success",
				]}
			>
				{totalCancelled}
			</div>
			<div class="text-sm text-muted mt-1">
				{pct(totalCancelled, totalDepartures)}% {t(lang, "stat.rate")}
			</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
				{t(lang, "stat.days_tracked")}
			</div>
			<div class="text-4xl font-bold tabular-nums">{days.length}</div>
		</div>
	</div>

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">
		{t(lang, "section.cancellation_rate")}
	</p>
	<CancellationChart days={chartDays} />

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">
		{t(lang, "operator.daily_breakdown")}
	</p>
	<div class="bg-surface border border-border rounded-xl overflow-hidden">
		<table class="w-full border-collapse">
			<thead>
				<tr class="bg-surface-hover border-b border-border">
					<th class="text-left px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{t(lang, "table.date")}</th>
					<th class="text-left px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{t(lang, "table.total")}</th>
					<th class="text-left px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{t(lang, "table.cancelled")}</th>
					<th class="text-left px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{t(lang, "table.rate")}</th>
					<th class="w-[120px] px-4 py-3 max-sm:hidden"></th>
				</tr>
			</thead>
			<tbody>
				{
					days.length > 0 ? (
						days.map((d) => {
							const rate = pct(d.cancelled, d.total);
							return (
								<tr class="border-b border-border-dim last:border-b-0 hover:bg-surface-hover">
									<td class="px-4 py-2.5 text-sm tabular-nums">{d.date}</td>
									<td class="px-4 py-2.5 text-sm tabular-nums">{d.total}</td>
									<td class="px-4 py-2.5 text-sm">
										{d.cancelled > 0 ? (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-danger/15 text-danger">{d.cancelled}</span>
										) : (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-success/10 text-success">0</span>
										)}
									</td>
									<td class="px-4 py-2.5 text-sm tabular-nums">{rate}%</td>
									<td class="w-[120px] px-4 py-2.5 max-sm:hidden">
										<div class="bg-border-dim rounded h-1.5 overflow-hidden">
											<div class="h-full rounded bg-danger" style={`width:${Math.min(parseFloat(rate) * 2, 100)}%`} />
										</div>
									</td>
								</tr>
							);
						})
					) : (
						<tr><td colspan="5" class="text-center text-dimmed py-8">{t(lang, "table.no_data")}</td></tr>
					)
				}
			</tbody>
		</table>
	</div>
</Layout>
