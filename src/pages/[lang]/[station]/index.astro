---
import { env } from "cloudflare:workers";
import HoursToggle from "../../../components/HoursToggle.astro";
import NextDepartures from "../../../components/NextDepartures.astro";
import WeekdayChart from "../../../components/WeekdayChart.astro";
import { createDb } from "../../../db/client";
import Layout from "../../../layouts/Layout.astro";
import { langFromParams, t } from "../../../lib/i18n";
import { getStats, parseFilter } from "../../../lib/queries";
import { categoryIcons, findStation } from "../../../lib/stations";
import {
	fmtDate,
	fmtDelay,
	fmtTimestamp,
	onTimeRate,
	pct,
	todayBerlin,
} from "../../../lib/utils";

const db = createDb(env.DB);
const lang = langFromParams(Astro.params);
const station = findStation(Astro.params.station!);
if (!station) return new Response("Not found", { status: 404 });

const filter = parseFilter(Astro.url);
const { coreOnly, days: daysFilter } = filter;
const stats = await getStats(db, station, filter);
const categories = stats.categories;

const today = todayBerlin();
const totalCancelled = stats.days.reduce((s, d) => s + d.cancelled, 0);
const totalDelayed = stats.days.reduce((s, d) => s + d.delayed, 0);
const totalDep = stats.days.reduce((s, d) => s + d.total, 0);
const score = onTimeRate(totalCancelled, totalDelayed, totalDep);
const todayStats = stats.days.find((d) => d.date === today);
---

<Layout title={station.name} lang={lang}>
	<a
		href={`/${lang}`}
		class="inline-flex items-center gap-1 text-muted text-sm mb-6 hover:text-link no-underline"
	>
		&larr; {t(lang, "nav.all_stations")}
	</a>

	<header class="mb-6">
		<h1 class="text-2xl font-bold text-emphasis flex items-center gap-2">
			{categoryIcons(categories)}
			{station.name}
		</h1>
		<p class="text-muted text-sm mt-1">
			{totalDep > 0 && <>{`${t(lang, "stat.reliability")}: ${score}% \u2014 `}</>}
			{stats.days.length > 0 && (
				<>
					{`${t(lang, "stat.since")} `}<time datetime={stats.days[stats.days.length - 1].date}>{fmtDate(stats.days[stats.days.length - 1].date, lang)}</time>
				</>
			)}
			{stats.lastChange && (
				<>
					{` \u2014 ${t(lang, "station.last_updated")} `}<time datetime={stats.lastChange}>{fmtTimestamp(stats.lastChange, lang)}</time>
				</>
			)}
		</p>
		{
			stats.haiku && (
				<blockquote class="mt-3 pl-4 border-l-[3px] border-border italic text-haiku whitespace-pre-line">
					{stats.haiku}
				</blockquote>
			)
		}
	</header>

	<HoursToggle basePath={`/${lang}/${station.slug}`} coreOnly={coreOnly} daysFilter={daysFilter} lang={lang} />

	<div class="grid grid-cols-3 gap-4 mb-8 max-sm:grid-cols-1">
				<div class="bg-surface border border-border rounded-xl p-5">
					<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.cancelled")} {t(lang, "stat.avg_per_day").toLowerCase()}</div>
					<div class:list={["text-4xl font-bold tabular-nums", totalCancelled > 0 ? "text-danger" : "text-success"]}>
						{stats.days.length > 0 ? (totalCancelled / stats.days.length).toFixed(1) : "0"}
					</div>
					<div class="text-sm text-muted mt-1">{pct(totalCancelled, totalDep)}% {t(lang, "stat.rate")}</div>
				</div>
				<div class="bg-surface border border-border rounded-xl p-5">
					<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "table.delayed")} {t(lang, "stat.avg_per_day").toLowerCase()}</div>
					<div class:list={["text-4xl font-bold tabular-nums", totalDelayed > 0 ? "text-warning" : "text-success"]}>
						{stats.days.length > 0 ? (totalDelayed / stats.days.length).toFixed(1) : "0"}
					</div>
					<div class="text-sm text-muted mt-1">{pct(totalDelayed, totalDep)}% {t(lang, "stat.rate")}</div>
				</div>
				<div class="bg-surface border border-border rounded-xl p-5">
					<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.today")}</div>
					{todayStats ? (
						<div class="text-sm tabular-nums mt-1">
							<span class:list={[todayStats.cancelled > 0 ? "text-danger" : "text-success"]}>{todayStats.cancelled} {t(lang, "stat.cancelled")}</span>
							{" / "}
							<span class:list={[todayStats.delayed > 0 ? "text-warning" : "text-success"]}>{todayStats.delayed} {t(lang, "table.delayed").toLowerCase()}</span>
							<div class="text-muted mt-1">{t(lang, "stat.of_departures", { total: todayStats.total })}</div>
						</div>
					) : (
						<div class="text-2xl font-bold tabular-nums text-muted">&mdash;</div>
					)}
				</div>
		</div>

	<NextDepartures server:defer stationSlug={station.slug} lang={lang} />

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">{t(lang, "section.weekday_pattern")}</p>
	<WeekdayChart days={stats.days} lang={lang} />

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">{t(lang, "section.daily_breakdown")}</p>
	<div class="bg-surface border border-border rounded-xl overflow-hidden">
		<table class="w-full border-collapse">
			<thead>
				<tr class="bg-surface-hover border-b border-border">
					{[t(lang, "table.date"), t(lang, "table.th.total"), t(lang, "table.th.cancelled"), t(lang, "table.th.delayed"), t(lang, "table.otp")].map((h) => (
						<th class="text-left px-2 sm:px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{h}</th>
					))}
				</tr>
			</thead>
			<tbody>
				{
					stats.days.length > 0 ? (
						stats.days.map((d) => {
							const issues = d.cancelled + d.delayed;
							return (
								<tr class="border-b border-border-dim last:border-b-0 hover:bg-surface-hover">
									<td class="px-2 sm:px-4 py-2.5 text-sm tabular-nums">
										<a href={`/${lang}/${station.slug}/day/${d.date}${Astro.url.search}`} class="text-link no-underline hover:underline">
											<time datetime={d.date}>{fmtDate(d.date, lang)}{d.date === today ? ` (${t(lang, "table.today")})` : ""}</time>
										</a>
									</td>
									<td class="px-2 sm:px-4 py-2.5 text-sm tabular-nums">{d.total}</td>
									<td class="px-2 sm:px-4 py-2.5 text-sm">
										{d.cancelled > 0 ? (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-danger/15 text-danger">{d.cancelled}</span>
										) : (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-success/10 text-success">0</span>
										)}
									</td>
									<td class="px-2 sm:px-4 py-2.5 text-sm">
										{d.delayed > 0 ? (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-warning/15 text-warning">{d.delayed}</span>
										) : (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-success/10 text-success">0</span>
										)}
										{d.avgDelay !== null && d.avgDelay > 0 && <span class="text-xs text-muted ml-1">{fmtDelay(d.avgDelay)}</span>}
									</td>
									<td class="px-2 sm:px-4 py-2.5 text-sm tabular-nums">{pct(d.total - issues, d.total)}%</td>
								</tr>
							);
						})
					) : (
						<tr><td colspan="5" class="text-center text-dimmed py-8">{t(lang, "table.no_data")}</td></tr>
					)
				}
			</tbody>
		</table>
	</div>
</Layout>
