---
import { env } from "cloudflare:workers";
import CancellationChart from "../../../components/CancellationChart.astro";
import HoursToggle from "../../../components/HoursToggle.astro";
import NextDepartures from "../../../components/NextDepartures.astro";
import { createDb } from "../../../db/client";
import Layout from "../../../layouts/Layout.astro";
import { langFromParams, t } from "../../../lib/i18n";
import {
	getStationCategories,
	getStats,
	parseFilter,
} from "../../../lib/queries";
import { categoryIcons, findStation } from "../../../lib/stations";
import {
	fmtDate,
	fmtDelay,
	fmtTimestamp,
	pct,
	todayBerlin,
} from "../../../lib/utils";

const db = createDb(env.DB);
const lang = langFromParams(Astro.params);
const station = findStation(Astro.params.station!);
if (!station) return new Response("Not found", { status: 404 });

const filter = parseFilter(Astro.url);
const { coreOnly, days: daysFilter } = filter;
const [stats, categories] = await Promise.all([
	getStats(db, station, filter),
	getStationCategories(db, station),
]);

const today = todayBerlin();
const todayStats = stats.days.find((d) => d.date === today);
const todayCancelled = todayStats?.cancelled ?? 0;
const todayTotal = todayStats?.total ?? 0;
---

<Layout title={station.name} lang={lang}>
	<a
		href={`/${lang}`}
		class="inline-flex items-center gap-1 text-muted text-sm mb-6 hover:text-link no-underline"
	>
		&larr; {t(lang, "nav.all_stations")}
	</a>

	<header class="mb-6">
		<h1 class="text-2xl font-bold text-emphasis flex items-center gap-2">
			{categoryIcons(categories)}
			{station.name}
		</h1>
		<p class="text-muted text-sm mt-1">
			{t(lang, "station.subtitle")}
			{
				stats.lastChange && (
					<>
						{` \u2014 ${t(lang, "station.last_updated")} ${fmtTimestamp(stats.lastChange)}`}
					</>
				)
			}
		</p>
		{
			stats.haiku && (
				<blockquote class="mt-3 pl-4 border-l-[3px] border-border italic text-haiku whitespace-pre-line">
					{stats.haiku}
				</blockquote>
			)
		}
	</header>

	<HoursToggle basePath={`/${lang}/${station.slug}`} coreOnly={coreOnly} daysFilter={daysFilter} lang={lang} />

	<div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 mb-8 max-sm:grid-cols-1">
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.today")}</div>
			<div class:list={["text-4xl font-bold tabular-nums", todayCancelled > 0 ? "text-danger" : "text-success"]}>
				{todayStats ? todayCancelled : "\u2014"}
			</div>
			<div class="text-sm text-muted mt-1">
				{todayStats ? t(lang, "stat.of_departures", { total: todayTotal, pct: pct(todayCancelled, todayTotal) }) : t(lang, "stat.no_data")}
			</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.avg_per_day")}</div>
			<div class="text-4xl font-bold tabular-nums">{stats.avgCancelledPerDay.toFixed(1)}</div>
			<div class="text-sm text-muted mt-1">
				{t(lang, "stat.cancelled")} ({stats.days.length > 0 ? pct(stats.days.reduce((s, d) => s + d.cancelled, 0), stats.days.reduce((s, d) => s + d.total, 0)) : "0.0"}% {t(lang, "stat.rate")})
			</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.days_tracked")}</div>
			<div class="text-4xl font-bold tabular-nums">{stats.days.length}</div>
			<div class="text-sm text-muted mt-1">
				{stats.days.length > 0 ? `${t(lang, "stat.since")} ${fmtDate(stats.days[stats.days.length - 1].date)}` : ""}
			</div>
		</div>
	</div>

	<NextDepartures server:defer stationSlug={station.slug} lang={lang} />

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">{t(lang, "section.cancellation_rate")}</p>
	<CancellationChart days={stats.days} />

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">{t(lang, "section.daily_breakdown")}</p>
	<div class="bg-surface border border-border rounded-xl overflow-hidden">
		<table class="w-full border-collapse">
			<thead>
				<tr class="bg-surface-hover border-b border-border">
					{[t(lang, "table.date"), t(lang, "table.total"), t(lang, "table.cancelled"), t(lang, "table.rate")].map((h) => (
						<th class="text-left px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{h}</th>
					))}
					<th class="w-[120px] px-4 py-3 max-sm:hidden text-[0.7rem] uppercase tracking-wide text-muted font-semibold"></th>
					<th class="text-left px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{t(lang, "table.avg_delay")}</th>
					<th class="text-left px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold max-sm:hidden" title={t(lang, "table.freq_deviation_tooltip")}>{t(lang, "table.freq_deviation")} <span class="cursor-help">&#9432;</span></th>
				</tr>
			</thead>
			<tbody>
				{
					stats.days.length > 0 ? (
						stats.days.map((d) => {
							const rate = pct(d.cancelled, d.total);
							return (
								<tr class="border-b border-border-dim last:border-b-0 hover:bg-surface-hover">
									<td class="px-4 py-2.5 text-sm tabular-nums">
										<a href={`/${lang}/${station.slug}/day/${d.date}${Astro.url.search}`} class="text-link no-underline hover:underline">
											{fmtDate(d.date)}{d.date === today ? ` (${t(lang, "table.today")})` : ""}
										</a>
									</td>
									<td class="px-4 py-2.5 text-sm tabular-nums">{d.total}</td>
									<td class="px-4 py-2.5 text-sm">
										{d.cancelled > 0 ? (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-danger/15 text-danger">{d.cancelled}</span>
										) : (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-success/10 text-success">0</span>
										)}
									</td>
									<td class="px-4 py-2.5 text-sm tabular-nums">{rate}%</td>
									<td class="w-[120px] px-4 py-2.5 max-sm:hidden">
										<div class="bg-border-dim rounded h-1.5 overflow-hidden">
											<div class="h-full rounded bg-danger" style={`width:${Math.min(parseFloat(rate) * 2, 100)}%`} />
										</div>
									</td>
									<td class="px-4 py-2.5 text-sm tabular-nums">{fmtDelay(d.avgDelay)}</td>
									<td class="px-4 py-2.5 text-sm tabular-nums max-sm:hidden">
										{d.plannedFreq !== null && d.actualFreq !== null
											? `${(d.actualFreq - d.plannedFreq) >= 0 ? "+" : ""}${(d.actualFreq - d.plannedFreq).toFixed(1)} min`
											: "\u2014"}
									</td>
								</tr>
							);
						})
					) : (
						<tr><td colspan="7" class="text-center text-dimmed py-8">{t(lang, "table.no_data")}</td></tr>
					)
				}
			</tbody>
		</table>
	</div>
</Layout>
