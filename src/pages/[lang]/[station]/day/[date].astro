---
import { env } from "cloudflare:workers";
import { createDb } from "../../../../db/client";
import Layout from "../../../../layouts/Layout.astro";
import { langFromParams, t } from "../../../../lib/i18n";
import {
	dayAvgDelay,
	getDayDepartures,
	getHaiku,
} from "../../../../lib/queries";
import { findStation } from "../../../../lib/stations";
import {
	delayMinutes,
	fmtDate,
	fmtDelay,
	nowBerlin,
	pct,
	shortDir,
	todayBerlin,
} from "../../../../lib/utils";

const lang = langFromParams(Astro.params);
const station = findStation(Astro.params.station!);
if (!station) return new Response("Not found", { status: 404 });

const db = createDb(env.DB);
const date = Astro.params.date!;
const [departures, haiku] = await Promise.all([
	getDayDepartures(db, station, date),
	getHaiku(db, date),
]);

const isToday = date === todayBerlin();
const nowTime = nowBerlin().format("HH:mm:ss");
const cancelledCount = departures.filter((d) => d.cancelled).length;
const avgDel = dayAvgDelay(departures);

let anchorPlaced = false;
---

<Layout title={`${fmtDate(date, lang)} — ${station.name}`} lang={lang}>
	<a
		href={`/${lang}/${station.slug}`}
		class="inline-flex items-center gap-1 text-muted text-sm mb-6 hover:text-link no-underline"
	>
		&larr; {t(lang, "nav.back")}
	</a>

	<header class="mb-6">
		<h1 class="text-2xl font-bold text-emphasis"><time datetime={date}>{fmtDate(date, lang)}</time></h1>
		<p class="text-muted text-sm mt-1">{station.name}</p>
		{
			haiku && (
				<blockquote class="mt-3 pl-4 border-l-[3px] border-border italic text-haiku whitespace-pre-line">
					{haiku}
				</blockquote>
			)
		}
	</header>

	<div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 mb-8 max-sm:grid-cols-1">
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.departures")}</div>
			<div class="text-4xl font-bold tabular-nums">{departures.length}</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "table.cancelled")}</div>
			<div class:list={["text-4xl font-bold tabular-nums", cancelledCount > 0 ? "text-danger" : "text-success"]}>
				{cancelledCount}
			</div>
			<div class="text-sm text-muted mt-1">{pct(cancelledCount, departures.length)}% {t(lang, "stat.cancellation_rate")}</div>
		</div>
		<div class="bg-surface border border-border rounded-xl p-5">
			<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "stat.avg_delay")}</div>
			<div class="text-2xl font-bold tabular-nums">{fmtDelay(avgDel)}</div>
			<div class="text-sm text-muted mt-1">{t(lang, "stat.cancelled_eq_freq")}</div>
		</div>
	</div>

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">{t(lang, "section.all_departures")}</p>
	<div class="bg-surface border border-border rounded-xl overflow-hidden">
		<table class="w-full border-collapse">
			<thead>
				<tr class="bg-surface-hover border-b border-border">
					{[t(lang, "table.time"), t(lang, "table.line"), t(lang, "table.direction"), t(lang, "table.status"), t(lang, "table.delay"), t(lang, "table.last_checked")].map((h) => (
						<th class="text-left px-4 py-3 text-[0.7rem] uppercase tracking-wide text-muted font-semibold">{h}</th>
					))}
				</tr>
			</thead>
			<tbody>
				{
					departures.length > 0 ? (
						departures.map((d) => {
							const time = d.time.slice(0, 5);
							const rtTime = d.rtTime?.slice(0, 5) ?? null;
							const delayMin = d.rtTime && d.rtDate
								? Math.round(delayMinutes(d.date, d.time, d.rtDate, d.rtTime))
								: null;
							let id: string | undefined;
							if (isToday && !anchorPlaced && d.time >= nowTime) {
								id = "now";
								anchorPlaced = true;
							}
							return (
								<tr id={id} class="border-b border-border-dim last:border-b-0 hover:bg-surface-hover">
									<td class="px-4 py-2.5 text-sm tabular-nums">
										{time}
										{rtTime && rtTime !== time && <span class="text-warning"> &rarr; {rtTime}</span>}
									</td>
									<td class="px-4 py-2.5 text-sm"><a href={`/${lang}/line/${encodeURIComponent(d.line)}`} class="text-link no-underline hover:underline">{d.line}</a></td>
									<td class="px-4 py-2.5 text-sm">{shortDir(d.direction)}</td>
									<td class="px-4 py-2.5 text-sm">
										{d.cancelled ? (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-danger/15 text-danger">{t(lang, "status.cancelled")}</span>
										) : (
											<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-success/10 text-success">{t(lang, "status.ok")}</span>
										)}
									</td>
									<td class="px-4 py-2.5 text-sm tabular-nums">
										{d.cancelled ? (
											<span class="text-muted">&mdash;</span>
										) : delayMin !== null && delayMin !== 0 ? (
											<span class={delayMin > 0 ? "text-warning" : "text-success"}>
												{delayMin > 0 ? "+" : ""}{delayMin} min
											</span>
										) : (
											<span class="text-muted">{t(lang, "status.on_time")}</span>
										)}
									</td>
									<td class="px-4 py-2.5 text-sm text-muted"><time datetime={d.fetchedAt}>{d.fetchedAt.slice(0, 16).replace("T", " ")}</time></td>
								</tr>
							);
						})
					) : (
						<tr><td colspan="6" class="text-center text-dimmed py-8">{t(lang, "table.no_departures")}</td></tr>
					)
				}
			</tbody>
		</table>
	</div>

	{isToday && <script>document.getElementById("now")?.scrollIntoView({behavior:"smooth",block:"center"})</script>}
</Layout>
