---
import { env } from "cloudflare:workers";
import HoursToggle from "../../components/HoursToggle.astro";
import { createDb } from "../../db/client";
import Layout from "../../layouts/Layout.astro";
import { langFromParams, t } from "../../lib/i18n";
import {
	getLineSummaries,
	getLineTrends,
	getOperatorSummaries,
	getOperatorTrends,
	getStationSummaries,
	getStationTrends,
	parseFilter,
} from "../../lib/queries";
import { categoryIcons, STATIONS } from "../../lib/stations";
import {
	onTimeRate,
	pct,
	scoreBorderColor,
	shortDir,
	trendArrow,
	trendColor,
} from "../../lib/utils";

const db = createDb(env.DB);
const lang = langFromParams(Astro.params);
const filter = parseFilter(Astro.url);
const { coreOnly, days: daysFilter } = filter;
const [
	stationStats,
	operators,
	lines,
	stationTrends,
	operatorTrends,
	lineTrends,
] = await Promise.all([
	getStationSummaries(db, STATIONS, filter),
	getOperatorSummaries(db, filter),
	getLineSummaries(db, filter),
	getStationTrends(db),
	getOperatorTrends(db),
	getLineTrends(db),
]);
---

<Layout title={t(lang, "home.title")} lang={lang}>
	<header class="mb-8">
		<h1 class="text-2xl font-bold text-emphasis flex items-center gap-2">
			🚌🚋🚇 DummRum
		</h1>
		<p class="text-muted text-sm mt-1">
			{t(lang, "home.subtitle")}
		</p>
	</header>

	<details class="mb-6 text-sm text-muted">
		<summary class="cursor-pointer select-none font-medium">{t(lang, "home.methodology_title")}</summary>
		<ul class="mt-2 list-disc pl-5 space-y-1">
			<li>{t(lang, "home.methodology_collection")}</li>
			<li>{t(lang, "home.methodology_cancellation")}</li>
			<li>{t(lang, "home.methodology_delay")}</li>
			<li>{t(lang, "home.methodology_delayed")}</li>
			<li>{t(lang, "home.methodology_reliability")}</li>
			<li>{t(lang, "home.methodology_colors")}</li>
		</ul>
	</details>

	<HoursToggle basePath={`/${lang}`} coreOnly={coreOnly} daysFilter={daysFilter} lang={lang} />

	{(() => {
		let totalAll = 0, cancelledAll = 0, delayedAll = 0;
		for (const [, st] of stationStats) {
			totalAll += st.total;
			cancelledAll += st.cancelled;
			delayedAll += st.delayed;
		}
		const score = onTimeRate(cancelledAll, delayedAll, totalAll);
		const color = score <= 85 ? "text-danger" : score <= 93 ? "text-warning" : "text-success";
		return totalAll > 0 ? (
			<div class="mb-8 bg-surface border border-border rounded-xl p-5 flex items-center gap-6">
				<div>
					<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "home.overall_score")}</div>
					<div class:list={["text-5xl font-bold tabular-nums", color]}>{score}<span class="text-lg text-muted">%</span></div>
				</div>
				<div class="text-sm text-muted">
					<div>{pct(cancelledAll, totalAll)}% {t(lang, "home.cancelled")} &middot; {pct(delayedAll, totalAll)}% {t(lang, "home.delayed")}</div>
					<div>{totalAll.toLocaleString(lang)} {t(lang, "stat.departures").toLowerCase()}</div>
				</div>
			</div>
		) : null;
	})()}

	<div class="relative mb-6">
		<input
			id="search"
			type="search"
			placeholder={t(lang, "search.placeholder")}
			class="w-full bg-surface border border-border rounded-xl px-4 py-2.5 text-sm text-text placeholder:text-muted focus:outline-none focus:border-link"
		/>
		<kbd class="absolute right-3 top-1/2 -translate-y-1/2 text-[0.6rem] text-dimmed bg-surface-hover border border-border-dim rounded px-1.5 py-0.5 pointer-events-none">Ctrl K</kbd>
	</div>

	<details class="group mb-8" open>
		<summary class="text-xs uppercase tracking-wide text-muted font-semibold mb-3 cursor-pointer select-none">
			{t(lang, "home.lines")}
		</summary>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-3 max-sm:grid-cols-2 mt-3">
			{
				[...lines].sort((a, b) => {
					const scoreA = onTimeRate(a.cancelled, a.delayed, a.total);
					const scoreB = onTimeRate(b.cancelled, b.delayed, b.total);
					return scoreA - scoreB;
				}).map((l) => {
					const tr = lineTrends.get(l.line);
					const arrow = tr ? trendArrow(tr, { cancelled: tr.prevCancelled, total: tr.prevTotal }) : "";
					const borderColor = scoreBorderColor(onTimeRate(l.cancelled, l.delayed, l.total));
					return (
						<a
							href={`/${lang}/line/${encodeURIComponent(l.line)}${Astro.url.search}`}
							data-search={`${l.line} ${l.category} ${l.operators.join(" ")}`.toLowerCase()}
							class:list={[
								"bg-surface border rounded-xl p-4 no-underline hover:bg-surface-hover transition-colors",
								borderColor,
							]}
						>
							<div class="text-lg font-bold text-emphasis">{categoryIcons([l.category])} {l.line}</div>
							<div class="text-xs text-muted">{l.operators.join(", ")}</div>
							<div class="text-sm text-muted mt-1">
								{pct(l.cancelled, l.total)}% {t(lang, "home.cancelled")} &middot; {pct(l.delayed, l.total)}% {t(lang, "home.delayed")}
							</div>
							{l.total > 0 && (
								<div class="text-xs text-muted mt-1">
									{t(lang, "stat.reliability")}: {onTimeRate(l.cancelled, l.delayed, l.total)}%
									{arrow && <span class={trendColor(arrow)}> {arrow}</span>}
								</div>
							)}
						</a>
					);
				})
			}
		</div>
	</details>

	<details class="group mb-8">
		<summary class="text-xs uppercase tracking-wide text-muted font-semibold mb-3 cursor-pointer select-none">
			{t(lang, "home.stations")}
		</summary>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 max-sm:grid-cols-1 mt-3">
		{
			[...STATIONS].sort((a, b) => {
				const ra = stationStats.get(a.id);
				const rb = stationStats.get(b.id);
				const scoreA = ra ? onTimeRate(ra.cancelled, ra.delayed, ra.total) : 100;
				const scoreB = rb ? onTimeRate(rb.cancelled, rb.delayed, rb.total) : 100;
				return scoreA - scoreB;
			}).map((s) => {
				const st = stationStats.get(s.id);
				const tr = stationTrends.get(s.id);
				const arrow = tr ? trendArrow(tr, { cancelled: tr.prevCancelled, total: tr.prevTotal }) : "";
				const score = st ? onTimeRate(st.cancelled, st.delayed, st.total) : 100;
				const borderColor = scoreBorderColor(score);
				return (
					<a
						href={`/${lang}/${s.slug}${Astro.url.search}`}
						data-search={s.name.toLowerCase()}
						class:list={[
							"bg-surface border rounded-xl p-5 no-underline hover:bg-surface-hover transition-colors",
							borderColor,
						]}
					>
						<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
							{categoryIcons(st?.categories ?? [])}
						</div>
						<div class="text-lg font-bold text-emphasis">
							{shortDir(s.name)}
						</div>
						{st && st.total > 0 && (
							<>
								<div class="text-sm text-muted mt-1">
									{pct(st.cancelled, st.total)}% {t(lang, "home.cancelled")} &middot; {pct(st.delayed, st.total)}% {t(lang, "home.delayed")}
								</div>
								<div class="text-xs text-muted mt-1">
									{t(lang, "stat.reliability")}: {onTimeRate(st.cancelled, st.delayed, st.total)}%
									{arrow && <span class={trendColor(arrow)}> {arrow}</span>}
								</div>
							</>
						)}
					</a>
				);
			})
		}
	</div>
	</details>

	<details class="group mb-8">
		<summary class="text-xs uppercase tracking-wide text-muted font-semibold mb-3 cursor-pointer select-none">
			{t(lang, "home.operators")}
		</summary>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4 max-sm:grid-cols-1 mt-3">
			{
				[...operators].sort((a, b) => {
					const scoreA = onTimeRate(a.cancelled, a.delayed, a.total);
					const scoreB = onTimeRate(b.cancelled, b.delayed, b.total);
					return scoreA - scoreB;
				}).map((op) => {
					const tr = operatorTrends.get(op.operator);
					const arrow = tr ? trendArrow(tr, { cancelled: tr.prevCancelled, total: tr.prevTotal }) : "";
					const borderColor = scoreBorderColor(onTimeRate(op.cancelled, op.delayed, op.total));
					return (
						<a
							href={`/${lang}/operator/${encodeURIComponent(op.operator)}${Astro.url.search}`}
							data-search={`${op.operator} ${op.lines.join(" ")}`.toLowerCase()}
							class:list={[
								"bg-surface border rounded-xl p-5 no-underline hover:bg-surface-hover transition-colors",
								borderColor,
							]}
						>
							<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
								{categoryIcons(op.categories)}
							</div>
							<div class="text-lg font-bold text-emphasis">
								{op.operator}
							</div>
							<div class="text-sm text-muted mt-1">
								{op.lines.join(", ")}
							</div>
							<div class="text-sm text-muted mt-1">
								{pct(op.cancelled, op.total)}% {t(lang, "home.cancelled")} &middot; {pct(op.delayed, op.total)}% {t(lang, "home.delayed")}
							</div>
							{op.total > 0 && (
								<div class="text-xs text-muted mt-1">
									{t(lang, "stat.reliability")}: {onTimeRate(op.cancelled, op.delayed, op.total)}%
									{arrow && <span class={trendColor(arrow)}> {arrow}</span>}
								</div>
							)}
						</a>
					);
				})
			}
		</div>
	</details>


</Layout>
