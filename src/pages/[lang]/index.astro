---
import { env } from "cloudflare:workers";
import { all } from "better-all";
import HoursToggle from "../../components/HoursToggle.astro";
import { createDb } from "../../db/client";
import Layout from "../../layouts/Layout.astro";
import { langFromParams, t } from "../../lib/i18n";
import {
	getHaiku,
	getLineSummaries,
	getOldestDate,
	getOperatorSummaries,
	getStopSummaries,
	parseFilter,
} from "../../lib/queries";
import { categoryIcons, STATIONS, slugForStop } from "../../lib/stations";
import {
	onTimeRate,
	pct,
	scoreBorderColor,
	shortStationName,
	todayBerlin,
} from "../../lib/utils";

const db = createDb(env.DB);
const lang = langFromParams(Astro.params);
const filter = parseFilter(Astro.url);
const { coreOnly, days: daysFilter, category } = filter;
const { stops, operators, lines, oldestDate, haiku } = await all({
	stops: () => getStopSummaries(db),
	operators: () => getOperatorSummaries(db, filter),
	lines: () => getLineSummaries(db, filter),
	oldestDate: () => getOldestDate(db),
	haiku: () => getHaiku(db, todayBerlin(), lang),
});

const stationById = new Map(STATIONS.map((s) => [s.id, s]));

const lineStations = new Map<string, string[]>();
for (const stop of stops) {
	for (const l of stop.lines) {
		const stations = lineStations.get(l) ?? [];
		stations.push(shortStationName(stop.stopName));
		lineStations.set(l, stations);
	}
}
---

<Layout title={t(lang, "home.title")} lang={lang}>
	<header class="mb-8">
		<h1 class="text-2xl font-bold text-emphasis flex items-center gap-2">
			🚏 DummRum
		</h1>
		<p class="text-muted text-sm mt-1">
			{t(lang, "home.subtitle")}
		</p>
		{oldestDate && (
			<p class="text-muted text-xs mt-1">
				{t(lang, "stat.since")} {new Date(oldestDate).toLocaleDateString(lang, { year: "numeric", month: "long", day: "numeric" })}
			</p>
		)}
		{haiku && (
			<div class="mt-3">
				<h2 class="text-xs font-medium text-muted uppercase tracking-wide mb-1">{t(lang, "haiku.heading")}</h2>
				<blockquote class="pl-4 border-l-[3px] border-border italic text-haiku whitespace-pre-line">
					{haiku}
				</blockquote>
			</div>
		)}
	</header>

	<details class="mb-6 text-sm text-muted">
		<summary class="cursor-pointer select-none font-medium">{t(lang, "home.methodology_title")}</summary>
		<ul class="mt-2 list-disc pl-5 space-y-1">
			<li>{t(lang, "home.methodology_collection")}</li>
			<li>{t(lang, "home.methodology_cancellation")}</li>
			<li>{t(lang, "home.methodology_delay")}</li>
			<li>{t(lang, "home.methodology_delayed")}</li>
			<li>{t(lang, "home.methodology_ghost")}</li>
			<li>{t(lang, "home.methodology_reliability")}</li>
			<li>{t(lang, "home.methodology_dedup")}</li>
			<li>{t(lang, "home.methodology_colors")}</li>
		</ul>
	</details>

	<HoursToggle basePath={`/${lang}`} coreOnly={coreOnly} daysFilter={daysFilter} category={category ?? ""} lang={lang} />

	{(() => {
		let totalAll = 0, cancelledAll = 0, ghostAll = 0, delayedAll = 0;
		for (const l of lines) {
			totalAll += l.total;
			cancelledAll += l.cancelled;
			ghostAll += l.ghost;
			delayedAll += l.delayed;
		}
		if (totalAll === 0) return null;
		const score = onTimeRate(cancelledAll, delayedAll, totalAll);
		const scoreWithGhosts = onTimeRate(cancelledAll + ghostAll, delayedAll, totalAll);
		const color = score < 80 ? "text-danger" : score < 90 ? "text-warning" : "text-success";

		type Worst = { name: string; count: number; rate: number };
		function isWorse(count: number, total: number, current: Worst | null): boolean {
			if (count === 0) return false;
			const rate = total > 0 ? count / total : 0;
			if (!current) return true;
			return rate > current.rate || (rate === current.rate && count > current.count);
		}
		let worstLineCancelled: Worst | null = null;
		let worstLineGhost: Worst | null = null;
		let worstLineDelayed: Worst | null = null;
		for (const l of lines) {
			if (isWorse(l.cancelled, l.total, worstLineCancelled)) worstLineCancelled = { name: l.line, count: l.cancelled, rate: l.total > 0 ? l.cancelled / l.total : 0 };
			if (isWorse(l.ghost, l.total, worstLineGhost)) worstLineGhost = { name: l.line, count: l.ghost, rate: l.total > 0 ? l.ghost / l.total : 0 };
			if (isWorse(l.delayed, l.total, worstLineDelayed)) worstLineDelayed = { name: l.line, count: l.delayed, rate: l.total > 0 ? l.delayed / l.total : 0 };
		}
		let worstStationCancelled: Worst | null = null;
		for (const stop of stops) {
			const name = shortStationName(stop.stopName);
			const total = stop.journeyCount;
			if (isWorse(stop.cancelled, total, worstStationCancelled)) worstStationCancelled = { name, count: stop.cancelled, rate: total > 0 ? stop.cancelled / total : 0 };
		}
		let worstOperatorCancelled: Worst | null = null;
		let worstOperatorGhost: Worst | null = null;
		let worstOperatorDelayed: Worst | null = null;
		for (const op of operators) {
			if (isWorse(op.cancelled, op.total, worstOperatorCancelled)) worstOperatorCancelled = { name: op.operator, count: op.cancelled, rate: op.total > 0 ? op.cancelled / op.total : 0 };
			if (isWorse(op.ghost, op.total, worstOperatorGhost)) worstOperatorGhost = { name: op.operator, count: op.ghost, rate: op.total > 0 ? op.ghost / op.total : 0 };
			if (isWorse(op.delayed, op.total, worstOperatorDelayed)) worstOperatorDelayed = { name: op.operator, count: op.delayed, rate: op.total > 0 ? op.delayed / op.total : 0 };
		}

		return (
			<div class="mb-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				<div class="bg-surface border border-border rounded-xl p-5">
					<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "home.overall_score")}</div>
					<div class:list={["text-5xl font-bold tabular-nums", color]}>{score}<span class="text-lg text-muted">%</span></div>
					{ghostAll > 0 && <div class="text-sm text-purple-400 mt-1">👻 {scoreWithGhosts}%</div>}
					<div class="text-sm text-muted mt-1">
						<div>{totalAll.toLocaleString(lang)} {t(lang, "stat.departures").toLowerCase()}</div>
					</div>
				</div>
				<div class="bg-surface border border-border rounded-xl p-5">
					<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "home.most_cancellations")}</div>
					{worstLineCancelled && worstLineCancelled.count > 0 && (
						<div class="text-sm mt-1"><span class="text-danger font-semibold">{(worstLineCancelled.rate * 100).toFixed(1)}%</span> <span class="text-muted">{t(lang, "home.line")}</span> <span class="font-semibold">{worstLineCancelled.name}</span></div>
					)}
					{worstStationCancelled && worstStationCancelled.count > 0 && (
						<div class="text-sm mt-1 truncate" title={worstStationCancelled.name}><span class="text-danger font-semibold">{(worstStationCancelled.rate * 100).toFixed(1)}%</span> <span class="text-muted">{t(lang, "home.station")}</span> <span class="font-semibold">{worstStationCancelled.name}</span></div>
					)}
					{worstOperatorCancelled && worstOperatorCancelled.count > 0 && (
						<div class="text-sm mt-1 truncate" title={worstOperatorCancelled.name}><span class="text-danger font-semibold">{(worstOperatorCancelled.rate * 100).toFixed(1)}%</span> <span class="text-muted">{t(lang, "home.operator")}</span> <span class="font-semibold">{worstOperatorCancelled.name}</span></div>
					)}
					{!worstLineCancelled?.count && <div class="text-2xl font-bold text-success">0</div>}
				</div>
				<div class="bg-surface border border-border rounded-xl p-5">
					<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "home.most_ghosts")}</div>
					{worstLineGhost && worstLineGhost.count > 0 && (
						<div class="text-sm mt-1"><span class="text-purple-400 font-semibold">{(worstLineGhost.rate * 100).toFixed(1)}%</span> <span class="text-muted">{t(lang, "home.line")}</span> <span class="font-semibold">{worstLineGhost.name}</span></div>
					)}
					{worstOperatorGhost && worstOperatorGhost.count > 0 && (
						<div class="text-sm mt-1 truncate" title={worstOperatorGhost.name}><span class="text-purple-400 font-semibold">{(worstOperatorGhost.rate * 100).toFixed(1)}%</span> <span class="text-muted">{t(lang, "home.operator")}</span> <span class="font-semibold">{worstOperatorGhost.name}</span></div>
					)}
					{!worstLineGhost?.count && <div class="text-2xl font-bold text-success">0</div>}
				</div>
				<div class="bg-surface border border-border rounded-xl p-5">
					<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">{t(lang, "home.most_delays")}</div>
					{worstLineDelayed && worstLineDelayed.count > 0 && (
						<div class="text-sm mt-1"><span class="text-warning font-semibold">{(worstLineDelayed.rate * 100).toFixed(1)}%</span> <span class="text-muted">{t(lang, "home.line")}</span> <span class="font-semibold">{worstLineDelayed.name}</span></div>
					)}
					{worstOperatorDelayed && worstOperatorDelayed.count > 0 && (
						<div class="text-sm mt-1 truncate" title={worstOperatorDelayed.name}><span class="text-warning font-semibold">{(worstOperatorDelayed.rate * 100).toFixed(1)}%</span> <span class="text-muted">{t(lang, "home.operator")}</span> <span class="font-semibold">{worstOperatorDelayed.name}</span></div>
					)}
					{!worstLineDelayed?.count && <div class="text-2xl font-bold text-success">0</div>}
				</div>
			</div>
		);
	})()}

	<div class="relative mb-4">
		<input
			id="search"
			type="search"
			placeholder={t(lang, "search.placeholder")}
			class="w-full bg-surface border border-border rounded-xl px-4 py-2.5 text-sm text-text placeholder:text-muted focus:outline-none focus:border-link"
		/>
		<kbd class="absolute right-3 top-1/2 -translate-y-1/2 text-[0.6rem] text-dimmed bg-surface-hover border border-border-dim rounded px-1.5 py-0.5 pointer-events-none">Ctrl K</kbd>
	</div>

	<details id="sec-lines" class="group mb-8">
		<summary class="text-xs uppercase tracking-wide text-muted font-semibold mb-3 cursor-pointer select-none">
			{t(lang, "home.lines")} ({lines.length})
		</summary>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-3 max-sm:grid-cols-2 mt-3">
			{
				[...lines].sort((a, b) => {
					const scoreA = onTimeRate(a.cancelled, a.delayed, a.total);
					const scoreB = onTimeRate(b.cancelled, b.delayed, b.total);
					return scoreA - scoreB || a.line.localeCompare(b.line, undefined, { numeric: true });
				}).map((l) => {
					const borderColor = scoreBorderColor(onTimeRate(l.cancelled, l.delayed, l.total));
					return (
						<a
							href={`/${lang}/line/${encodeURIComponent(l.line)}${Astro.url.search}`}
							data-search={`${l.line} ${l.category} ${l.operators.join(" ")} ${l.destinations.join(" ")} ${(lineStations.get(l.line) ?? []).join(" ")}`.toLowerCase()}
						data-categories={l.category}
							class:list={[
								"bg-surface border rounded-xl p-4 no-underline hover:bg-surface-hover transition-colors",
								borderColor,
							]}
						>
							<div class="text-lg font-bold text-emphasis">{categoryIcons([l.category])} {l.line}</div>
							<div class="text-xs text-muted truncate" title={l.destinations.join(" \u2194 ")}>{l.destinations.join(" \u2194 ")}</div>
							<div class="text-sm text-muted mt-1">
								{pct(l.cancelled, l.total)}% {t(lang, "home.cancelled")} &middot; {l.ghost > 0 && <>{pct(l.ghost, l.total)}% 👻 &middot; </>}{pct(l.delayed, l.total)}% {t(lang, "home.delayed")}
							</div>
							{l.total > 0 && (
								<div class="text-xs text-muted mt-1">
									{t(lang, "stat.reliability")}: {onTimeRate(l.cancelled, l.delayed, l.total)}%{l.ghost > 0 && <span class="text-purple-400"> (👻 {onTimeRate(l.cancelled + l.ghost, l.delayed, l.total)}%)</span>}
								</div>
							)}
						</a>
					);
				})
			}
		</div>
	</details>

	<details id="sec-stations" class="group mb-8">
		<summary class="text-xs uppercase tracking-wide text-muted font-semibold mb-3 cursor-pointer select-none">
			{t(lang, "home.stations")} ({stops.length})
		</summary>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 max-sm:grid-cols-1 mt-3">
		{
			stops.map((stop) => {
				const href = `/${lang}/${slugForStop(stop.stopIds, stop.stopName)}${Astro.url.search}`;
				const cancRate = stop.journeyCount > 0 ? stop.cancelled / stop.journeyCount : 0;
				const borderColor = cancRate > 0.1 ? "border-danger" : cancRate > 0.05 ? "border-warning" : "border-success";
				return (
					<a
						href={href}
						data-search={`${shortStationName(stop.stopName)} ${stop.lines.join(" ")}`.toLowerCase()}
						data-categories={stop.categories.join(",")}
						class:list={[
							"bg-surface border rounded-xl p-5 no-underline transition-colors hover:bg-surface-hover",
							borderColor,
						]}
					>
						<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
							{categoryIcons(stop.categories)}
						</div>
						<div class="text-lg font-bold text-emphasis">
							{shortStationName(stop.stopName)}
						</div>
						{stop.lines.length > 0 && (
							<div class="text-xs text-muted truncate" title={stop.lines.join(", ")}>{stop.lines.join(", ")}</div>
						)}
						{stop.journeyCount > 0 ? (
							<div class="text-sm text-muted mt-1">
								{stop.journeyCount} {t(lang, "stat.departures").toLowerCase()} &middot; {pct(stop.cancelled, stop.journeyCount)}% {t(lang, "home.cancelled")}
							</div>
						) : (
							<div class="text-sm text-dimmed mt-1">{t(lang, "table.no_data")}</div>
						)}
					</a>
				);
			})
		}
	</div>
	</details>

	<details id="sec-operators" class="group mb-8">
		<summary class="text-xs uppercase tracking-wide text-muted font-semibold mb-3 cursor-pointer select-none">
			{t(lang, "home.operators")} ({operators.length})
		</summary>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4 max-sm:grid-cols-1 mt-3">
			{
				[...operators].sort((a, b) => {
					const scoreA = onTimeRate(a.cancelled, a.delayed, a.total);
					const scoreB = onTimeRate(b.cancelled, b.delayed, b.total);
					return scoreA - scoreB || a.operator.localeCompare(b.operator);
				}).map((op) => {
					const borderColor = scoreBorderColor(onTimeRate(op.cancelled, op.delayed, op.total));
					return (
						<a
							href={`/${lang}/operator/${encodeURIComponent(op.operator)}${Astro.url.search}`}
							data-search={`${op.operator} ${op.lines.join(" ")}`.toLowerCase()}
							data-categories={op.categories.join(",")}
							class:list={[
								"bg-surface border rounded-xl p-5 no-underline hover:bg-surface-hover transition-colors",
								borderColor,
							]}
						>
							<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
								{categoryIcons(op.categories)}
							</div>
							<div class="text-lg font-bold text-emphasis">
								{op.operator}
							</div>
							<div class="text-sm text-muted mt-1">
								{op.lines.join(", ")}
							</div>
							<div class="text-sm text-muted mt-1">
								{pct(op.cancelled, op.total)}% {t(lang, "home.cancelled")} &middot; {op.ghost > 0 && <>{pct(op.ghost, op.total)}% 👻 &middot; </>}{pct(op.delayed, op.total)}% {t(lang, "home.delayed")}
							</div>
							{op.total > 0 && (
								<div class="text-xs text-muted mt-1">
									{t(lang, "stat.reliability")}: {onTimeRate(op.cancelled, op.delayed, op.total)}%{op.ghost > 0 && <span class="text-purple-400"> (👻 {onTimeRate(op.cancelled + op.ghost, op.delayed, op.total)}%)</span>}
								</div>
							)}
						</a>
					);
				})
			}
		</div>
	</details>

	<script>
		document.addEventListener("astro:page-load", () => {
			const ids = ["sec-lines", "sec-stations", "sec-operators"];
			const key = "dummrum:open-sections";
			const saved = new Set(JSON.parse(localStorage.getItem(key) ?? "[]"));
			for (const id of ids) {
				const el = document.getElementById(id) as HTMLDetailsElement | null;
				if (!el) continue;
				if (saved.has(id)) el.open = true;
				el.addEventListener("toggle", () => {
					const open: string[] = [];
					for (const id of ids) {
						const d = document.getElementById(id) as HTMLDetailsElement | null;
						if (d?.open) open.push(id);
					}
					localStorage.setItem(key, JSON.stringify(open));
				});
			}
		});
	</script>
</Layout>
