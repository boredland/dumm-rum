---
import { env } from "cloudflare:workers";
import HoursToggle from "../../components/HoursToggle.astro";
import { createDb } from "../../db/client";
import Layout from "../../layouts/Layout.astro";
import { langFromParams, t } from "../../lib/i18n";
import { getOperatorSummaries, getStationSummaries } from "../../lib/queries";
import { categoryIcons, STATIONS } from "../../lib/stations";
import { fmtDelay, pct, shortDir } from "../../lib/utils";

const db = createDb(env.DB);
const lang = langFromParams(Astro.params);
const coreOnly = Astro.url.searchParams.get("hours") === "core";
const hoursParam = coreOnly ? "?hours=core" : "";
const [stationStats, operators] = await Promise.all([
	getStationSummaries(db, STATIONS, coreOnly),
	getOperatorSummaries(db, coreOnly),
]);
---

<Layout title={t(lang, "home.title")} lang={lang}>
	<header class="mb-8">
		<h1 class="text-2xl font-bold text-emphasis flex items-center gap-2">
			🚌🚋🚇 DummRum
		</h1>
		<p class="text-muted text-sm mt-1">
			{t(lang, "home.subtitle")}
		</p>
	</header>

	<HoursToggle basePath={`/${lang}`} coreOnly={coreOnly} lang={lang} />

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">
		{t(lang, "home.stations")}
	</p>

	<div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 mb-8 max-sm:grid-cols-1">
		{
			STATIONS.map((s) => {
				const st = stationStats.get(s.id);
				const rate =
					st && st.total > 0
						? (st.cancelled / st.total) * 100
						: 0;
				const borderColor =
					rate >= 5
						? "border-danger"
						: rate >= 1
							? "border-warning"
							: "border-success";
				return (
					<a
						href={`/${lang}/${s.slug}${hoursParam}`}
						class:list={[
							"bg-surface border rounded-xl p-5 no-underline hover:bg-surface-hover transition-colors",
							borderColor,
						]}
					>
						<div class="text-[0.7rem] uppercase tracking-wide text-muted mb-1">
							{categoryIcons(st?.categories ?? [])}
						</div>
						<div class="text-lg font-bold text-emphasis">
							{shortDir(s.name)}
						</div>
						{st && (
							<div class="text-sm text-muted mt-1">
								{pct(st.cancelled, st.total)}% {t(lang, "home.cancelled")}
							</div>
						)}
					</a>
				);
			})
		}
	</div>

	<details class="mb-8">
		<summary class="text-xs uppercase tracking-wide text-muted font-semibold mb-3 cursor-pointer select-none list-none flex items-center gap-1.5">
			<svg class="w-3 h-3 transition-transform [[open]>&]:rotate-90" viewBox="0 0 12 12" fill="currentColor">
				<path d="M4.5 2l5 4-5 4V2z" />
			</svg>
			{t(lang, "home.operators")}
		</summary>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4 max-sm:grid-cols-1 mt-3">
			{
				operators.map((op) => {
					const rate = op.total > 0 ? (op.cancelled / op.total) * 100 : 0;
					const borderColor =
						rate >= 5
							? "border-danger"
							: rate >= 1
								? "border-warning"
								: "border-success";
					return (
						<a
							href={`/${lang}/operator/${encodeURIComponent(op.operator)}${hoursParam}`}
							class:list={[
								"bg-surface border rounded-xl p-5 no-underline hover:bg-surface-hover transition-colors",
								borderColor,
							]}
						>
							<div class="text-lg font-bold text-emphasis">
								{op.operator}
							</div>
							<div class="text-sm text-muted mt-1">
								{op.lines.join(", ")}
							</div>
							<div class="text-sm text-muted mt-1">
								{pct(op.cancelled, op.total)}% {t(lang, "home.cancelled")}
								{op.avgDelay !== null && <> &middot; {fmtDelay(op.avgDelay)}</>}
							</div>
						</a>
					);
				})
			}
		</div>
	</details>
</Layout>
