---
export const prerender = true;

import HoursToggle from "../../components/HoursToggle.astro";
import StationCards from "../../components/StationCards.astro";
import Layout from "../../layouts/Layout.astro";
import { langFromParams, languages, t } from "../../lib/i18n";

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = langFromParams(Astro.params);
const coreOnly = Astro.url.searchParams.get("hours") === "core";
---

<Layout title={t(lang, "home.title")} lang={lang}>
	<header class="mb-8">
		<h1 class="text-2xl font-bold text-emphasis flex items-center gap-2">
			🚌🚋🚇 DummRum
		</h1>
		<p class="text-muted text-sm mt-1">
			{t(lang, "home.subtitle")}
		</p>
	</header>

	<HoursToggle basePath={`/${lang}`} coreOnly={coreOnly} lang={lang} />

	<p class="text-xs uppercase tracking-wide text-muted font-semibold mb-3">
		{t(lang, "home.stations")}
	</p>

	<StationCards server:defer lang={lang} coreOnly={coreOnly}>
		<div slot="fallback" class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4 mb-8 max-sm:grid-cols-1">
			{Array.from({ length: 7 }).map(() => (
				<div class="bg-surface border border-border rounded-xl p-5 animate-pulse">
					<div class="h-3 w-12 bg-border-dim rounded mb-2"></div>
					<div class="h-5 w-32 bg-border-dim rounded mb-2"></div>
					<div class="h-3 w-20 bg-border-dim rounded"></div>
				</div>
			))}
		</div>
	</StationCards>
</Layout>
