---
import Layout from "../../layouts/Layout.astro";
import { langFromParams, t } from "../../lib/i18n";

const lang = langFromParams(Astro.params);
---

<Layout title={t(lang, "map.title")} lang={lang}>
	<div class="mb-3 flex items-center justify-between">
		<a href={`/${lang}`} class="text-sm text-muted hover:text-emphasis transition-colors">&larr; {t(lang, "nav.back")}</a>
		<span id="vehicle-count" class="text-sm text-muted"></span>
	</div>

	<div id="map" class="rounded-lg border border-border overflow-hidden" style="height: calc(100dvh - 180px); min-height: 400px;"></div>

	<div class="mt-3 flex flex-wrap items-center gap-2">
		<button data-cat="all" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors bg-surface-hover text-emphasis">{t(lang, "filter.all")}</button>
		<button data-cat="U-Bahn" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">U-Bahn</button>
		<button data-cat="S" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">S-Bahn</button>
		<button data-cat="Tram" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">Tram</button>
		<button data-cat="Bus" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">Bus</button>
		<button data-cat="RE,RB" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">RE/RB</button>
		<span class="ml-auto text-xs text-dimmed" id="last-update"></span>
	</div>

	<footer class="mt-4 pt-4 border-t border-border-dim flex items-center gap-3">
		<a href="https://www.rmv.de" class="shrink-0">
			<img src="/rmv-logo.svg" alt="RMV" width="74" height="15" class="opacity-60 hover:opacity-100 transition-opacity" />
		</a>
		<span class="text-xs text-dimmed">{lang === "de" ? "Datenquelle: RMV" : "Data source: RMV"}</span>
	</footer>
</Layout>

<style>
	@keyframes ghost-shimmer { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.8; } }
</style>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.fullscreen@3.0.2/Control.FullScreen.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline src="https://unpkg.com/leaflet.fullscreen@3.0.2/Control.FullScreen.js"></script>

<script is:inline define:vars={{ lang, noVehiclesText: t(lang, "map.no_vehicles"), vehiclesText: t(lang, "map.vehicles"), lastUpdateText: t(lang, "map.last_update") }}>
function normalizeCategory(cat) {
	if (!cat) return cat;
	if (cat === "S") return "S-Bahn";
	if (/bus$/i.test(cat) || cat === "AST") return "Bus";
	if (/straßenbahn$/i.test(cat) || /strassenbahn$/i.test(cat)) return "Tram";
	return cat;
}

const CATEGORY_ICON_URLS = {
	"U-Bahn": "/icons/ubahn.svg",
	"S-Bahn": "/icons/sbahn.svg",
	"Tram": "/icons/tram.svg",
	"Bus": "/icons/bus.svg",
	"RE": "/icons/reg.svg",
	"RB": "/icons/reg.svg",
};

function createVehicleIcon(cat, sleeping, ghost, delayed) {
	if (ghost) return createGhostIcon(cat);
	const iconUrl = CATEGORY_ICON_URLS[normalizeCategory(cat)] || CATEGORY_ICON_URLS["Bus"];
	const opacity = sleeping ? "opacity:0.5;" : "";
	const badge = sleeping
		? `<span style="position:absolute;top:-8px;right:-6px;font-size:10px;line-height:1">💤</span>`
		: delayed
			? `<span style="position:absolute;top:-6px;right:-6px;font-size:9px;line-height:1;background:#cf222e;color:white;border-radius:4px;padding:1px 3px;font-weight:bold">+${delayed}</span>`
			: "";
	const border = delayed ? "outline:2px solid #cf222e;outline-offset:1px;" : "";
	return L.divIcon({
		className: "",
		html: `<div style="position:relative;${opacity}"><img src="${iconUrl}" width="30" height="30" style="border-radius:50%;box-shadow:0 2px 6px rgba(0,0,0,.35);${border}" />${badge}</div>`,
		iconSize: [30, 30],
		iconAnchor: [15, 15],
		popupAnchor: [0, -17],
		tooltipAnchor: [0, -17],
	});
}

function createGhostIcon(cat) {
	const iconUrl = CATEGORY_ICON_URLS[normalizeCategory(cat)] || CATEGORY_ICON_URLS["Bus"];
	return L.divIcon({
		className: "",
		html: `<div style="position:relative;animation:ghost-shimmer 2s ease-in-out infinite"><img src="${iconUrl}" width="30" height="30" style="border-radius:50%;box-shadow:0 2px 6px rgba(0,0,0,.35)" /></div>`,
		iconSize: [30, 30],
		iconAnchor: [15, 15],
		popupAnchor: [0, -17],
		tooltipAnchor: [0, -17],
	});
}

const iconCache = new Map();
function getVehicleIcon(cat, sleeping, ghost, delayMin) {
	const key = ghost ? `${cat}:ghost` : delayed(delayMin) ? `${cat}:delay:${delayMin}` : sleeping ? `${cat}:zzz` : cat;
	if (!iconCache.has(key)) iconCache.set(key, createVehicleIcon(cat, sleeping, ghost, delayMin));
	return iconCache.get(key);
}
function delayed(min) { return min && min >= 8; }

function formatTime(isoString) {
	if (!isoString) return "?";
	try {
		const d = new Date(isoString);
		if (isNaN(d.getTime())) {
			const match = isoString.match(/(\d{2}):(\d{2})/);
			return match ? `${match[1]}:${match[2]}` : isoString;
		}
		return d.toLocaleTimeString(lang, { hour: "2-digit", minute: "2-digit" });
	} catch {
		return isoString;
	}
}

function matchesFilter(cat, filter) {
	if (filter === "all") return true;
	const n = normalizeCategory(cat);
	if (filter === "RE,RB") return n === "RE" || n === "RB";
	return n === filter || (filter === "S" && n === "S-Bahn");
}

let map;
let markers = new Map();
let activeFilter = "all";
let vehicleState = new Map();
let fetchInterval;
let animFrameId;

function updateHash() {
	if (!map) return;
	const c = map.getCenter();
	const z = map.getZoom();
	const cat = activeFilter === "all" ? "" : `/${encodeURIComponent(activeFilter)}`;
	history.replaceState(null, "", `#${c.lat.toFixed(5)}/${c.lng.toFixed(5)}/${z}${cat}`);
}

function initMap() {
	if (map) {
		map.remove();
		map = null;
		markers = new Map();
		vehicleState = new Map();
	}
	const el = document.getElementById("map");
	if (!el) return;

	const hash = window.location.hash.slice(1);
	const parts = hash.split("/");
	const initLat = parts.length >= 3 ? +parts[0] : 50.11;
	const initLon = parts.length >= 3 ? +parts[1] : 8.68;
	const initZoom = parts.length >= 3 ? +parts[2] : 12;
	if (parts.length >= 4 && parts[3]) {
		activeFilter = decodeURIComponent(parts[3]);
		applyFilter(activeFilter);
	}

	map = L.map(el, { zoomControl: true }).setView([initLat, initLon], initZoom);
	if (L.control.fullscreen) L.control.fullscreen({ position: "topleft" }).addTo(map);
	map.on("enterFullscreen exitFullscreen", () => setTimeout(() => map.invalidateSize(), 100));
	const tiles = L.tileLayer("https://tile.memomaps.de/tilegen/{z}/{x}/{y}.png", {
		attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &middot; <a href="https://memomaps.de/">memomaps.de</a>',
		maxZoom: 18,
	});
	const osm = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
		attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
		maxZoom: 19,
	});
	tiles.on("tileerror", () => { if (!map.hasLayer(osm)) { tiles.remove(); osm.addTo(map); } });
	tiles.addTo(map);

	map.on("moveend", updateHash);
	map.on("zoomend", updateHash);
}

async function fetchAndRender() {
	try {
		// Cache-bust the browser cache. A previous deploy left
		// /api/live-map pinned in some browsers' caches for up to 4h
		// with the old payload shape, which made newer JS read
		// `v.stopCount` as undefined and skip every tracked vehicle.
		// Rounding to 30s buckets keeps the CDN edge cache effective
		// while still defeating any stale browser-cached response.
		const bucket = Math.floor(Date.now() / 30000);
		const resp = await fetch(`/api/live-map?t=${bucket}`);
		if (!resp.ok) return;
		const data = await resp.json();
		const vehicles = data.vehicles || [];

		const seen = new Set();

		const nowSec = new Date().getHours() * 3600 + new Date().getMinutes() * 60 + new Date().getSeconds();
		for (const v of vehicles) {
			const isGhost = !!v.ghost;
			const stops = v.stops ? JSON.parse(v.stops) : [];
			if (stops.length < 2) { continue; }
			seen.add(v.id);
			const cat = v.category || "Bus";
			const visible = matchesFilter(cat, activeFilter);
			const depSec = timeToSeconds(v.originDepTime);
			const destSec = timeToSeconds(v.destArrTime);
			const sleeping = !isGhost && depSec !== null && depSec > nowSec;

			const poly = v.polyline ? JSON.parse(v.polyline) : null;
			const parsedStops = stops.map(s => ({
				lat: s.lat, lon: s.lon,
				arrSec: timeToSeconds(s.arr),
				depSec: timeToSeconds(s.dep),
				polyIdx: 0,
			}));
			if (poly) {
				for (const s of parsedStops) {
					s.polyIdx = nearestPolylineIndex(poly, s.lat, s.lon);
				}
			}

			const initLat = v.lat ?? parsedStops[0]?.lat ?? 50.11;
			const initLon = v.lon ?? parsedStops[0]?.lon ?? 8.68;

			const firstStopDep = parsedStops[0]?.depSec;
			const delayMin = (depSec !== null && firstStopDep !== null && firstStopDep > depSec)
				? Math.round((firstStopDep - depSec) / 60)
				: 0;

			const gpsLat = v.lat ?? null;
			const gpsLon = v.lon ?? null;
			const hasGps = !isGhost && gpsLat !== null && gpsLon !== null;
			// Seconds-of-day for when the GPS fix was reported. Used to
			// anchor the between-fetch smooth interpolation.
			let gpsReportedSec = null;
			if (hasGps && v.reportedAt) {
				const r = new Date(v.reportedAt);
				gpsReportedSec = r.getHours() * 3600 + r.getMinutes() * 60 + r.getSeconds();
			}
			// Cached polyline index of the GPS fix. Lets the animation walk
			// along the route from where the vehicle actually is instead of
			// from the scheduled "from" stop.
			const gpsPolyIdx = hasGps && poly
				? nearestPolylineIndex(poly, gpsLat, gpsLon)
				: null;

			vehicleState.set(v.id, {
				lat: initLat, lon: initLon,
				gpsLat, gpsLon, hasGps, gpsReportedSec, gpsPolyIdx,
				destArrSec: destSec, cat, isGhost, delayMin,
				polyline: poly, stops: parsedStops,
			});

			if (markers.has(v.id)) {
				const m = markers.get(v.id);
				m.setIcon(getVehicleIcon(cat, sleeping, isGhost, delayMin));
				m.setPopupContent(popupContent(v));
				if (hasGps) m.setLatLng([gpsLat, gpsLon]);
				if (visible && !map.hasLayer(m)) m.addTo(map);
				else if (!visible && map.hasLayer(m)) m.remove();
			} else {
				const m = L.marker([initLat, initLon], { icon: getVehicleIcon(cat, sleeping, isGhost, delayMin) });
				m.bindPopup(popupContent(v));
				m._vehicleCategory = cat;
				if (visible) m.addTo(map);
				markers.set(v.id, m);
			}
		}

		for (const [id, m] of markers) {
			if (!seen.has(id)) {
				m.remove();
				markers.delete(id);
				vehicleState.delete(id);
			}
		}

		const visibleCount = [...markers.values()].filter(m => map.hasLayer(m)).length;
		const countEl = document.getElementById("vehicle-count");
		if (countEl) countEl.textContent = visibleCount === 0 ? noVehiclesText : `${visibleCount} ${vehiclesText}`;

		const updateEl = document.getElementById("last-update");
		if (updateEl) {
			const now = new Date();
			updateEl.textContent = `${lastUpdateText}: ${now.toLocaleTimeString(lang, { hour: "2-digit", minute: "2-digit", second: "2-digit" })}`;
		}
	} catch (e) {
		console.error("live-map fetch failed:", e);
	}
}

function fmtTime(t) {
	if (!t) return "";
	return t.slice(0, 5);
}

function popupContent(v) {
	const dep = fmtTime(v.originDepTime);
	const arr = fmtTime(v.destArrTime);
	const schedule = dep && arr ? `${dep} → ${arr}` : "";
	const lines = [
		`<strong>${v.line}</strong> → ${shortName(v.destination)}`,
		shortName(v.origin),
		v.operator || "",
		schedule ? `<span style="color:#656d76">${schedule}</span>` : "",
		v.ghost ? `<span style="color:#93559a">👻 scheduled position</span>` : `<span style="color:#656d76">GPS: ${formatTime(v.reportedAt)}</span>`,
	].filter(Boolean);
	return lines.join("<br/>");
}

function shortName(name) {
	return (name || "").replace(/Frankfurt \(Main\)\s*/g, "");
}

function applyFilter(cat) {
	activeFilter = cat;
	for (const pill of document.querySelectorAll(".cat-pill")) {
		const match = pill.dataset.cat === cat;
		pill.classList.toggle("bg-surface-hover", match);
		pill.classList.toggle("text-emphasis", match);
		pill.classList.toggle("text-muted", !match);
	}
	for (const [, m] of markers) {
		const visible = matchesFilter(m._vehicleCategory, cat);
		if (visible && !map.hasLayer(m)) m.addTo(map);
		else if (!visible && map.hasLayer(m)) m.remove();
	}
	const total = markers.size;
	let visibleCount = 0;
	for (const [, m] of markers) {
		if (matchesFilter(m._vehicleCategory, activeFilter)) visibleCount++;
	}
	const countEl = document.getElementById("vehicle-count");
	if (countEl) countEl.textContent = total === 0 ? noVehiclesText : `${visibleCount} ${vehiclesText}`;
	if (map) updateHash();
}

function timeToSeconds(t) {
	if (!t) return null;
	const parts = t.split(":");
	return (+parts[0]) * 3600 + (+parts[1]) * 60 + (+parts[2] || 0);
}

function distSq(a, b) {
	const dx = a[0] - b[0], dy = a[1] - b[1];
	return dx * dx + dy * dy;
}

function nearestPolylineIndex(poly, lat, lon) {
	let best = 0, bestD = Infinity;
	for (let i = 0; i < poly.length; i++) {
		const d = distSq(poly[i], [lat, lon]);
		if (d < bestD) { bestD = d; best = i; }
	}
	return best;
}

function interpolateAlongPolyline(poly, startIdx, endIdx, progress) {
	if (endIdx <= startIdx) return poly[Math.min(startIdx, poly.length - 1)];
	const target = startIdx + (endIdx - startIdx) * progress;
	const i = Math.min(Math.floor(target), poly.length - 2);
	const frac = target - i;
	return [
		poly[i][0] + (poly[i + 1][0] - poly[i][0]) * frac,
		poly[i][1] + (poly[i + 1][1] - poly[i][1]) * frac,
	];
}

function findCurrentSegment(stops, nowSec, state) {
	const cached = state._segIdx;
	if (cached != null && cached < stops.length - 1) {
		const dep = stops[cached].depSec;
		const arr = stops[cached + 1].arrSec;
		if (dep !== null && arr !== null && arr > dep && nowSec >= dep && nowSec <= arr) {
			return { from: stops[cached], to: stops[cached + 1], progress: (nowSec - dep) / (arr - dep) };
		}
	}
	for (let i = 0; i < stops.length - 1; i++) {
		const dep = stops[i].depSec;
		const arr = stops[i + 1].arrSec;
		if (dep !== null && arr !== null && arr > dep && nowSec >= dep && nowSec <= arr) {
			state._segIdx = i;
			return { from: stops[i], to: stops[i + 1], progress: (nowSec - dep) / (arr - dep) };
		}
	}
	for (let i = stops.length - 2; i >= 0; i--) {
		const dep = stops[i].depSec;
		if (dep !== null && nowSec >= dep) {
			state._segIdx = i;
			const arr = stops[i + 1].arrSec ?? dep + 60;
			return { from: stops[i], to: stops[i + 1], progress: Math.min(1, (nowSec - dep) / (arr - dep)) };
		}
	}
	return null;
}

function interpolatePositions() {
	const now = new Date();
	const nowSec = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds() + now.getMilliseconds() / 1000;
	for (const [id, state] of vehicleState) {
		const m = markers.get(id);
		if (!m) continue;

		// Let the server drive removals — fetchAndRender prunes vehicles the
		// server no longer returns. Removing client-side off of scheduled arrival
		// time races with the 30s CDN cache on /api/live-map and can hide active
		// vehicles mid-flight.

		// Tracked vehicles: use GPS as the truth anchor and interpolate from
		// there toward the next scheduled stop at schedule pace. Gives smooth
		// motion that starts from the real position rather than whatever the
		// schedule thinks the from-stop is. Ghosts (no GPS) fall through to
		// pure schedule interp below.
		if (state.hasGps && state.gpsLat !== null && state.gpsLon !== null) {
			const segFromGps = findCurrentSegment(state.stops, nowSec, state);
			if (!segFromGps || segFromGps.to.arrSec === null) {
				m.setLatLng([state.gpsLat, state.gpsLon]);
				continue;
			}
			const gpsSec = state.gpsReportedSec ?? (segFromGps.from.depSec ?? 0);
			const baselineSec = Math.max(gpsSec, segFromGps.from.depSec ?? 0);
			const arrSec = segFromGps.to.arrSec;
			if (arrSec <= baselineSec) {
				m.setLatLng([state.gpsLat, state.gpsLon]);
				continue;
			}
			const frac = Math.max(
				0,
				Math.min(1, (nowSec - baselineSec) / (arrSec - baselineSec)),
			);
			// Polyline-aware: walk along the actual route from the GPS point
			// toward the next stop's polyline index. Falls back to a straight
			// line when no polyline is available for this run.
			if (
				state.polyline &&
				state.polyline.length >= 2 &&
				state.gpsPolyIdx != null
			) {
				const targetIdx = segFromGps.to.polyIdx ?? state.polyline.length - 1;
				if (targetIdx > state.gpsPolyIdx) {
					m.setLatLng(
						interpolateAlongPolyline(
							state.polyline,
							state.gpsPolyIdx,
							targetIdx,
							frac,
						),
					);
					continue;
				}
			}
			m.setLatLng([
				state.gpsLat + (segFromGps.to.lat - state.gpsLat) * frac,
				state.gpsLon + (segFromGps.to.lon - state.gpsLon) * frac,
			]);
			continue;
		}

		const seg = findCurrentSegment(state.stops, nowSec, state);
		const stale = !seg && !state.isGhost;
		if (stale !== state._stale) {
			state._stale = stale;
			m.setIcon(getVehicleIcon(state.cat, stale, state.isGhost, state.delayMin));
		}

		if (seg) {
			if (state.polyline && state.polyline.length >= 2) {
				const startIdx = seg.from.polyIdx ?? 0;
				const endIdx = seg.to.polyIdx ?? 0;
				if (endIdx > startIdx) {
					m.setLatLng(interpolateAlongPolyline(state.polyline, startIdx, endIdx, seg.progress));
				} else {
					m.setLatLng([
						seg.from.lat + (seg.to.lat - seg.from.lat) * seg.progress,
						seg.from.lon + (seg.to.lon - seg.from.lon) * seg.progress,
					]);
				}
			} else {
				m.setLatLng([
					seg.from.lat + (seg.to.lat - seg.from.lat) * seg.progress,
					seg.from.lon + (seg.to.lon - seg.from.lon) * seg.progress,
				]);
			}
		}
	}
	animFrameId = requestAnimationFrame(interpolatePositions);
}

function init() {
	clearInterval(fetchInterval);
	cancelAnimationFrame(animFrameId);
	initMap();
	if (!map) return;
	fetchAndRender();
	fetchInterval = setInterval(fetchAndRender, 30_000);
	animFrameId = requestAnimationFrame(interpolatePositions);

	for (const pill of document.querySelectorAll(".cat-pill")) {
		pill.addEventListener("click", () => applyFilter(pill.dataset.cat));
	}
}

document.addEventListener("astro:page-load", init);
document.addEventListener("astro:before-swap", () => {
	clearInterval(fetchInterval);
	cancelAnimationFrame(animFrameId);
});
</script>
