---
import Layout from "../../layouts/Layout.astro";
import { langFromParams, t } from "../../lib/i18n";

const lang = langFromParams(Astro.params);
---

<Layout title={t(lang, "map.title")} lang={lang}>
	<div class="mb-3 flex items-center justify-between">
		<a href={`/${lang}`} class="text-sm text-muted hover:text-emphasis transition-colors">&larr; {t(lang, "nav.back")}</a>
		<span id="vehicle-count" class="text-sm text-muted"></span>
	</div>

	<div id="map" class="rounded-lg border border-border overflow-hidden" style="height: calc(100dvh - 180px); min-height: 400px;"></div>

	<div class="mt-3 flex flex-wrap items-center gap-2">
		<button data-cat="all" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors bg-surface-hover text-emphasis">{t(lang, "filter.all")}</button>
		<button data-cat="U-Bahn" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">U-Bahn</button>
		<button data-cat="S" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">S-Bahn</button>
		<button data-cat="Tram" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">Tram</button>
		<button data-cat="Bus" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">Bus</button>
		<button data-cat="RE,RB" class="cat-pill px-2.5 py-1 text-xs font-medium rounded-full border border-border cursor-pointer transition-colors text-muted">RE/RB</button>
		<span class="ml-auto text-xs text-dimmed" id="last-update"></span>
	</div>
</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script is:inline define:vars={{ lang, noVehiclesText: t(lang, "map.no_vehicles"), vehiclesText: t(lang, "map.vehicles"), lastUpdateText: t(lang, "map.last_update") }}>
const CATEGORY_COLORS = {
	"U-Bahn": "#0065ae",
	"S": "#00843d",
	"S-Bahn": "#00843d",
	"Tram": "#c4122e",
	"Bus": "#93559a",
	"RE": "#ec6608",
	"RB": "#ec6608",
	"RE,RB": "#ec6608",
};

const CATEGORY_ICONS = {
	"U-Bahn": `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="14" rx="3"/><line x1="8" y1="21" x2="8" y2="17"/><line x1="16" y1="21" x2="16" y2="17"/><line x1="9" y1="10" x2="9" y2="10.01"/><line x1="15" y1="10" x2="15" y2="10.01"/></svg>`,
	"S": `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="12" rx="2"/><path d="M4 9h16"/><line x1="8" y1="20" x2="8" y2="16"/><line x1="16" y1="20" x2="16" y2="16"/><circle cx="9" cy="13" r="0.5"/><circle cx="15" cy="13" r="0.5"/></svg>`,
	"Tram": `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="6" width="14" height="13" rx="3"/><line x1="9" y1="23" x2="7" y2="19"/><line x1="15" y1="23" x2="17" y2="19"/><line x1="8" y1="2" x2="12" y2="6"/><line x1="16" y1="2" x2="12" y2="6"/><line x1="9" y1="13" x2="9" y2="13.01"/><line x1="15" y1="13" x2="15" y2="13.01"/></svg>`,
	"Bus": `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6v6"/><path d="M16 6v6"/><path d="M2 12h19.6"/><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H6C4.9 6 3.9 6.8 3.6 7.8l-1.4 5c-.1.4-.2.8-.2 1.2 0 .4.1.8.2 1.2C2.5 16.3 3 18 3 18h3"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>`,
	"RE": `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11V4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v7"/><path d="M2 16l2-5h16l2 5"/><line x1="4" y1="20" x2="8" y2="16"/><line x1="20" y1="20" x2="16" y2="16"/><circle cx="8" cy="16" r="0.01"/><circle cx="16" cy="16" r="0.01"/></svg>`,
};
CATEGORY_ICONS["S-Bahn"] = CATEGORY_ICONS["S"];
CATEGORY_ICONS["RB"] = CATEGORY_ICONS["RE"];

function categoryColor(cat) {
	return CATEGORY_COLORS[cat] || "#6e7681";
}

function categoryIcon(cat) {
	return CATEGORY_ICONS[cat] || CATEGORY_ICONS["Bus"];
}

function createVehicleIcon(cat, sleeping) {
	const color = categoryColor(cat);
	const icon = categoryIcon(cat);
	const opacity = sleeping ? "opacity:0.5;" : "";
	const zzz = sleeping ? `<span style="position:absolute;top:-8px;right:-6px;font-size:10px;line-height:1">💤</span>` : "";
	return L.divIcon({
		className: "",
		html: `<div style="position:relative;${opacity}background:${color};border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border:2px solid white;box-shadow:0 2px 6px rgba(0,0,0,.35)">${icon}${zzz}</div>`,
		iconSize: [28, 28],
		iconAnchor: [14, 14],
		popupAnchor: [0, -16],
		tooltipAnchor: [0, -16],
	});
}

const iconCache = new Map();
function getVehicleIcon(cat, sleeping) {
	const key = sleeping ? `${cat}:zzz` : cat;
	if (!iconCache.has(key)) iconCache.set(key, createVehicleIcon(cat, sleeping));
	return iconCache.get(key);
}

function formatTime(isoString) {
	if (!isoString) return "?";
	try {
		const d = new Date(isoString);
		if (isNaN(d.getTime())) {
			const match = isoString.match(/(\d{2}):(\d{2})/);
			return match ? `${match[1]}:${match[2]}` : isoString;
		}
		return d.toLocaleTimeString(lang, { hour: "2-digit", minute: "2-digit" });
	} catch {
		return isoString;
	}
}

function matchesFilter(cat, filter) {
	if (filter === "all") return true;
	if (filter === "RE,RB") return cat === "RE" || cat === "RB";
	return cat === filter || (filter === "S" && cat === "S-Bahn");
}

let map;
let markers = new Map();
let activeFilter = "all";
let vehicleState = new Map();
let fetchInterval;
let animFrameId;

function updateHash() {
	if (!map) return;
	const c = map.getCenter();
	const z = map.getZoom();
	const cat = activeFilter === "all" ? "" : `/${encodeURIComponent(activeFilter)}`;
	history.replaceState(null, "", `#${c.lat.toFixed(5)}/${c.lng.toFixed(5)}/${z}${cat}`);
}

function initMap() {
	if (map) {
		map.remove();
		map = null;
		markers = new Map();
		vehicleState = new Map();
	}
	const el = document.getElementById("map");
	if (!el) return;

	const hash = window.location.hash.slice(1);
	const parts = hash.split("/");
	const initLat = parts.length >= 3 ? +parts[0] : 50.11;
	const initLon = parts.length >= 3 ? +parts[1] : 8.68;
	const initZoom = parts.length >= 3 ? +parts[2] : 12;
	if (parts.length >= 4 && parts[3]) {
		activeFilter = decodeURIComponent(parts[3]);
		applyFilter(activeFilter);
	}

	map = L.map(el, { zoomControl: true }).setView([initLat, initLon], initZoom);
	const transit = L.tileLayer("https://tile.memomaps.de/tilegen/{z}/{x}/{y}.png", {
		attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &middot; <a href="https://memomaps.de/">memomaps.de</a>',
		maxZoom: 18,
	});
	const osm = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
		attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
		maxZoom: 19,
	});
	transit.on("tileerror", () => { if (!map.hasLayer(osm)) { transit.remove(); osm.addTo(map); } });
	transit.addTo(map);

	map.on("moveend", updateHash);
	map.on("zoomend", updateHash);
}

async function fetchAndRender() {
	try {
		const resp = await fetch("/api/live-map");
		if (!resp.ok) return;
		const data = await resp.json();
		const vehicles = data.vehicles || [];

		const seen = new Set();

		const nowSec = new Date().getHours() * 3600 + new Date().getMinutes() * 60 + new Date().getSeconds();
		for (const v of vehicles) {
			if (!v.nextArrTime) { continue; }
			seen.add(v.id);
			const cat = v.category || "Bus";
			const visible = matchesFilter(cat, activeFilter);
			const depSec = timeToSeconds(v.originDepTime);
			const sleeping = depSec !== null && depSec > nowSec;

			const poly = v.polyline ? JSON.parse(v.polyline) : null;
			vehicleState.set(v.id, {
				lat: v.lat, lon: v.lon,
				nextLat: v.nextLat, nextLon: v.nextLon,
				lastDepTime: v.lastDepTime, nextArrTime: v.nextArrTime,
				polyline: poly,
				startIdx: poly ? nearestPolylineIndex(poly, v.lat, v.lon) : 0,
				endIdx: (poly && v.nextLat && v.nextLon) ? nearestPolylineIndex(poly, v.nextLat, v.nextLon) : 0,
			});

			if (markers.has(v.id)) {
				const m = markers.get(v.id);
				m.setIcon(getVehicleIcon(cat, sleeping));
				m.setPopupContent(popupContent(v));
				m.setTooltipContent(`${v.line} → ${shortName(v.destination)}`);
				if (visible && !map.hasLayer(m)) m.addTo(map);
				else if (!visible && map.hasLayer(m)) m.remove();
			} else {
				const m = L.marker([v.lat, v.lon], { icon: getVehicleIcon(cat, sleeping) });
				m.bindPopup(popupContent(v));
				m.bindTooltip(`${v.line} → ${shortName(v.destination)}`, { direction: "top" });
				m._vehicleCategory = cat;
				if (visible) m.addTo(map);
				markers.set(v.id, m);
			}
		}

		for (const [id, m] of markers) {
			if (!seen.has(id)) {
				m.remove();
				markers.delete(id);
				vehicleState.delete(id);
			}
		}

		const visibleCount = vehicles.filter(v => matchesFilter(v.category || "Bus", activeFilter)).length;
		const countEl = document.getElementById("vehicle-count");
		if (countEl) countEl.textContent = vehicles.length === 0 ? noVehiclesText : `${visibleCount} ${vehiclesText}`;

		const updateEl = document.getElementById("last-update");
		if (updateEl) {
			const now = new Date();
			updateEl.textContent = `${lastUpdateText}: ${now.toLocaleTimeString(lang, { hour: "2-digit", minute: "2-digit", second: "2-digit" })}`;
		}
	} catch (e) {
		console.error("live-map fetch failed:", e);
	}
}

function popupContent(v) {
	return `<strong>${v.line}</strong> → ${shortName(v.destination)}<br/>${v.operator || ""}<br/><span style="color:#656d76">Position: ${formatTime(v.reportedAt)}</span>`;
}

function shortName(name) {
	return (name || "").replace(/Frankfurt \(Main\)\s*/g, "");
}

function applyFilter(cat) {
	activeFilter = cat;
	for (const pill of document.querySelectorAll(".cat-pill")) {
		const match = pill.dataset.cat === cat;
		pill.classList.toggle("bg-surface-hover", match);
		pill.classList.toggle("text-emphasis", match);
		pill.classList.toggle("text-muted", !match);
	}
	for (const [, m] of markers) {
		const visible = matchesFilter(m._vehicleCategory, cat);
		if (visible && !map.hasLayer(m)) m.addTo(map);
		else if (!visible && map.hasLayer(m)) m.remove();
	}
	const total = markers.size;
	let visibleCount = 0;
	for (const [, m] of markers) {
		if (matchesFilter(m._vehicleCategory, activeFilter)) visibleCount++;
	}
	const countEl = document.getElementById("vehicle-count");
	if (countEl) countEl.textContent = total === 0 ? noVehiclesText : `${visibleCount} ${vehiclesText}`;
	if (map) updateHash();
}

function timeToSeconds(t) {
	if (!t) return null;
	const parts = t.split(":");
	return (+parts[0]) * 3600 + (+parts[1]) * 60 + (+parts[2] || 0);
}

function distSq(a, b) {
	const dx = a[0] - b[0], dy = a[1] - b[1];
	return dx * dx + dy * dy;
}

function nearestPolylineIndex(poly, lat, lon) {
	let best = 0, bestD = Infinity;
	for (let i = 0; i < poly.length; i++) {
		const d = distSq(poly[i], [lat, lon]);
		if (d < bestD) { bestD = d; best = i; }
	}
	return best;
}

function interpolateAlongPolyline(poly, startIdx, endIdx, progress) {
	if (endIdx <= startIdx) return poly[Math.min(startIdx, poly.length - 1)];
	const target = startIdx + (endIdx - startIdx) * progress;
	const i = Math.min(Math.floor(target), poly.length - 2);
	const frac = target - i;
	return [
		poly[i][0] + (poly[i + 1][0] - poly[i][0]) * frac,
		poly[i][1] + (poly[i + 1][1] - poly[i][1]) * frac,
	];
}

function interpolatePositions() {
	const now = new Date();
	const nowSec = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds() + now.getMilliseconds() / 1000;
	for (const [id, state] of vehicleState) {
		const m = markers.get(id);
		if (!m) continue;

		const depSec = timeToSeconds(state.lastDepTime);
		const arrSec = timeToSeconds(state.nextArrTime);
		const canInterpolate = depSec !== null && arrSec !== null && arrSec > depSec && nowSec >= depSec && nowSec <= arrSec;

		if (canInterpolate) {
			const progress = (nowSec - depSec) / (arrSec - depSec);
			if (state.polyline && state.polyline.length >= 2 && state.endIdx > state.startIdx) {
				m.setLatLng(interpolateAlongPolyline(state.polyline, state.startIdx, state.endIdx, progress));
			} else if (state.nextLat && state.nextLon) {
				m.setLatLng([
					state.lat + (state.nextLat - state.lat) * progress,
					state.lon + (state.nextLon - state.lon) * progress,
				]);
			}
		}
	}
	animFrameId = requestAnimationFrame(interpolatePositions);
}

function init() {
	clearInterval(fetchInterval);
	cancelAnimationFrame(animFrameId);
	initMap();
	if (!map) return;
	fetchAndRender();
	fetchInterval = setInterval(fetchAndRender, 60_000);
	animFrameId = requestAnimationFrame(interpolatePositions);

	for (const pill of document.querySelectorAll(".cat-pill")) {
		pill.addEventListener("click", () => applyFilter(pill.dataset.cat));
	}
}

document.addEventListener("astro:page-load", init);
</script>
