{
	"name": "ingest",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun src/index.ts",
		"dev": "bun --watch src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write",
		"check": "tsc --noEmit && biome check",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"dayjs": "^1.11.20",
		"drizzle-orm": "^1.0.0-beta.20",
		"pg-boss": "^10.3.2",
		"postgres": "^3.4.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@types/bun": "^1.3.1",
		"lefthook": "^2.1.4",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
