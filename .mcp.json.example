{
	"mcpServers": {
		"postgres-ingest-dev": {
			"command": "bunx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-postgres",
				"postgresql://ingest:ingest@localhost:54321/ingest"
			]
		},
		"postgres-ingest-prod": {
			"command": "bunx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-postgres",
				"postgresql://<user>:<pass>@<host>:<port>/<db>"
			]
		}
	}
}
