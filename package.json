{
	"name": "dummrum",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "tsgo --noEmit && biome check && knip",
		"generate:api": "openapi-typescript https://www.rmv.de/hapi/api-doc -o src/lib/hafas-types.ts",
		"db:generate": "drizzle-kit generate && npm run db:sync",
		"db:sync": "for f in drizzle/*/migration.sql; do d=$(basename $(dirname $f)); cp $f migrations/$d.sql; done",
		"db:migrate": "wrangler d1 migrations apply rmv-departures --remote",
		"db:migrate:local": "wrangler d1 migrations apply rmv-departures --local",
		"deploy": "astro build && npm run db:migrate && wrangler deploy",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.1.4",
		"astro": "^6.1.1",
		"better-all": "^0.0.7",
		"dayjs": "^1.11.20",
		"drizzle-orm": "^1.0.0-beta.20",
		"openapi-fetch": "^0.17.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@cloudflare/workers-types": "^4.20260317.1",
		"@tailwindcss/vite": "^4.2.2",
		"@typescript/native-preview": "^7.0.0-dev.20260327.2",
		"drizzle-kit": "^1.0.0-beta.20",
		"knip": "^6.1.0",
		"lefthook": "^2.1.4",
		"openapi-typescript": "^7.13.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.4.0",
		"wrangler": "^4.78.0"
	},
	"overrides": {
		"vite": "^7.3.1"
	}
}
