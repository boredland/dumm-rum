{
	"name": "ingest",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun serve.ts",
		"build": "vite build",
		"dev": "vite",
		"worker": "bun src/index.ts",
		"worker:dev": "bun --watch src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write",
		"check": "tsc --noEmit && biome check",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@fontsource/fira-mono": "^5.3.0",
		"@fontsource/fira-sans": "^5.3.0",
		"@tanstack/react-router": "^1.168.22",
		"@tanstack/react-start": "^1.167.41",
		"dayjs": "^1.11.20",
		"drizzle-orm": "^1.0.0-beta.20",
		"pg-boss": "^10.3.2",
		"postgres": "^3.4.7",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/router-plugin": "^1.167.22",
		"@types/bun": "^1.3.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^1.0.0-beta.20",
		"lefthook": "^2.1.4",
		"playwright": "^1.59.1",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.8"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
