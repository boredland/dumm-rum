{
	"name": "rmv-collector",
	"private": true,
	"scripts": {
		"build": "wrangler deploy",
		"check": "tsgo --noEmit && biome check",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"db:init": "wrangler d1 execute rmv-departures --file=./schema.sql",
		"db:init:local": "wrangler d1 execute rmv-departures --local --file=./schema.sql",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@cloudflare/workers-types": "^4.20240301.0",
		"@typescript/native-preview": "^7.0.0-dev.20260327.2",
		"lefthook": "^2.1.4",
		"typescript": "^5.4.0",
		"wrangler": "^4.77.0"
	},
	"dependencies": {
		"dayjs": "^1.11.20"
	}
}
